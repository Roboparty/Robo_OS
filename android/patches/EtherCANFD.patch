diff --git a/rtthread/applications/pdo.c b/rtthread/applications/pdo.c
new file mode 100644
index 0000000..48f3f89
--- /dev/null
+++ b/rtthread/applications/pdo.c
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "object_dictionary.h"
+#include "pdo.h"
+#include "esc.h"
+#include <assert.h>
+#include <string.h>
+
+_Static_assert(htoes(0x1234) == 0x1234 && htoel(0x12345678) == 0x12345678,
+               "HPM6E80 SOES must use little-endian conversions");
+#if !defined(EC_LITTLE_ENDIAN) || defined(EC_BIG_ENDIAN)
+#error "HPM6E80 SOES must use little-endian bitfields"
+#endif
+
+/* SOES's numeric bit-slicer does not copy STRING(4). Keep all payload fields
+ * as bytes, including bytes 60..63, without changing the existing ESI types. */
+void gateway_pdo_copy(uint8_t *buffer, uint16_t first_index, bool to_od)
+{
+    static const unsigned sizes[] = {2, 2, 1, 1, 2, 30, 30, 4};
+    unsigned offset = 0;
+    for (unsigned ch = 0; ch < 4; ++ch) {
+        for (unsigned sub = 1; sub <= 8; ++sub) {
+            void *data = od_data(first_index + ch * 16, sub, sizes[sub - 1]);
+            assert(data);
+            if (to_od) memcpy(data, buffer + offset, sizes[sub - 1]);
+            else memcpy(buffer + offset, data, sizes[sub - 1]);
+            offset += sizes[sub - 1];
+        }
+    }
+    assert(offset == 288);
+}
+
+void gateway_rxpdo(void)
+{
+    uint8_t buffer[MAX_RXPDO_SIZE] CC_ALIGNED(8);
+    ESC_read(ESC_SM2_sma, buffer, sizeof(buffer));
+    gateway_pdo_copy(buffer, 0x7000, true);
+}
+
+void gateway_txpdo(void)
+{
+    uint8_t buffer[MAX_TXPDO_SIZE] CC_ALIGNED(8);
+    gateway_pdo_copy(buffer, 0x6000, false);
+    ESC_write(ESC_SM3_sma, buffer, sizeof(buffer));
+}
