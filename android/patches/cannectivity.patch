+++ b/app/boards/nucleo_g474re_stm32g474xx.overlay
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "stm32_fs_dual.dtsi"
+
+/* 160 MHz APB1, divided by two at the shared FDCAN kernel. */
+&pll { mul-n = <80>; };
+&rcc { clock-frequency = <DT_FREQ_M(160)>; };
+&fdcan1 {
+	clocks = <&rcc STM32_CLOCK(APB1, 25)>, <&rcc STM32_SRC_PCLK FDCAN_SEL(2)>;
+	clk-divider = <2>;
+};
+&fdcan2 {
+	clocks = <&rcc STM32_CLOCK(APB1, 25)>, <&rcc STM32_SRC_PCLK FDCAN_SEL(2)>;
+	clk-divider = <2>;
+};
+&fdcan3 {
+	clocks = <&rcc STM32_CLOCK(APB1, 25)>, <&rcc STM32_SRC_PCLK FDCAN_SEL(2)>;
+	pinctrl-0 = <&fdcan3_rx_pa8 &fdcan3_tx_pa15>;
+	pinctrl-names = "default";
+	clk-divider = <2>;
+	status = "okay";
+};
+&cannectivity {
+	channel2 {
+		compatible = "cannectivity-channel";
+		can-controller = <&fdcan3>;
+	};
+};
+&timers2 { st,prescaler = <159>; };
+&pwm2 { status = "disabled"; };
+&i2c1 { status = "disabled"; };
+&spi2 { status = "disabled"; };
+&spi3 { status = "disabled"; };
