+/* SPDX-License-Identifier: Apache-2.0 */
+#include <soc.h>
+#include <stddef.h>
+#include <zephyr/devicetree.h>
+#include <zephyr/sys/util.h>
+
+/* Check our board description against the pinned vendor device pack. */
+BUILD_ASSERT(DT_REG_ADDR(DT_NODELABEL(rcc)) == RCC_BASE);
+BUILD_ASSERT(DT_REG_ADDR(DT_NODELABEL(gpioa)) == GPIOA_BASE);
+BUILD_ASSERT(DT_REG_ADDR(DT_NODELABEL(gpiob)) == GPIOB_BASE);
+BUILD_ASSERT(DT_REG_ADDR(DT_NODELABEL(fdcan1)) == FDCAN1_BASE);
+BUILD_ASSERT(DT_REG_ADDR(DT_NODELABEL(fdcan2)) == FDCAN2_BASE);
+BUILD_ASSERT(DT_REG_ADDR(DT_NODELABEL(fdcan3)) == FDCAN3_BASE);
+BUILD_ASSERT(DT_REG_ADDR_BY_IDX(DT_NODELABEL(fdcan1), 1) == SRAMCAN_BASE);
+BUILD_ASSERT(DT_REG_ADDR(DT_NODELABEL(usb)) == USB_DRD_FS_BASE);
+BUILD_ASSERT(DT_PROP(DT_NODELABEL(usb), ram_size) == USB_DRD_PMA_SIZE);
+BUILD_ASSERT(DT_IRQ_BY_IDX(DT_NODELABEL(fdcan1), 0, irq) == FDCAN1_IT0_IRQn);
+BUILD_ASSERT(DT_IRQ_BY_IDX(DT_NODELABEL(fdcan1), 1, irq) == FDCAN1_IT1_IRQn);
+BUILD_ASSERT(DT_IRQ_BY_IDX(DT_NODELABEL(fdcan2), 0, irq) == FDCAN2_IT0_IRQn);
+BUILD_ASSERT(DT_IRQ_BY_IDX(DT_NODELABEL(fdcan2), 1, irq) == FDCAN2_IT1_IRQn);
+BUILD_ASSERT(DT_IRQ_BY_IDX(DT_NODELABEL(fdcan3), 0, irq) == FDCAN3_IT0_IRQn);
+BUILD_ASSERT(DT_IRQ_BY_IDX(DT_NODELABEL(fdcan3), 1, irq) == FDCAN3_IT1_IRQn);
+BUILD_ASSERT(DT_IRQN(DT_NODELABEL(usb)) == USB_DRD_FS_IRQn);
+BUILD_ASSERT(DT_REG_ADDR(DT_NODELABEL(timers2)) == TIM2_BASE);
+BUILD_ASSERT(DT_IRQN(DT_NODELABEL(timers2)) == TIM2_IRQn);
+BUILD_ASSERT(DT_REG_SIZE(DT_NODELABEL(sram0)) == SRAM1_SIZE + SRAM2_SIZE + SRAM3_SIZE);
+BUILD_ASSERT(DT_REG_ADDR(DT_NODELABEL(sram0)) == SRAM1_BASE);
+BUILD_ASSERT(SRAM1_BASE + SRAM1_SIZE == SRAM2_BASE);
+BUILD_ASSERT(SRAM2_BASE + SRAM2_SIZE == SRAM3_BASE);
+BUILD_ASSERT(DT_REG_ADDR(DT_NODELABEL(flash0)) == FLASH_BASE);
+BUILD_ASSERT(DT_REG_SIZE(DT_NODELABEL(flash0)) == FLASH_SIZE_DEFAULT);
+BUILD_ASSERT(DT_CLOCKS_CELL(DT_NODELABEL(gpioa), bits) == RCC_AHB4ENR_GPIOAEN);
+BUILD_ASSERT(DT_CLOCKS_CELL(DT_NODELABEL(gpiob), bits) == RCC_AHB4ENR_GPIOBEN);
+BUILD_ASSERT(DT_CLOCKS_CELL(DT_NODELABEL(timers2), bits) == RCC_APB1LENR_TIM2EN);
+BUILD_ASSERT(DT_CLOCKS_CELL(DT_NODELABEL(fdcan1), bits) == RCC_APB1HENR_FDCANEN);
+BUILD_ASSERT(DT_CLOCKS_CELL(DT_NODELABEL(fdcan2), bits) == RCC_APB1HENR_FDCANEN);
+BUILD_ASSERT(DT_CLOCKS_CELL(DT_NODELABEL(fdcan3), bits) == RCC_APB1HENR_FDCANEN);
+BUILD_ASSERT(DT_CLOCKS_CELL(DT_NODELABEL(usb), bits) == RCC_APB2ENR_USBEN);
+BUILD_ASSERT(DT_PROP(DT_NODELABEL(rcc), clock_frequency) == 64000000);
+BUILD_ASSERT(CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC == 64000000);
+BUILD_ASSERT(offsetof(RCC_TypeDef, AHB4ENR) == 0x94);
+BUILD_ASSERT(offsetof(RCC_TypeDef, APB1LENR) == 0x9c);
+BUILD_ASSERT(offsetof(RCC_TypeDef, APB1HENR) == 0xa0);
+BUILD_ASSERT(offsetof(RCC_TypeDef, APB2ENR) == 0xa4);
+BUILD_ASSERT(offsetof(RCC_TypeDef, APB1LRSTR) == 0x74);
+
+void soc_early_init_hook(void)
+{
+	/* TZEN=0, reset HSI clock, no bootloader clock inheritance. */
+	SystemCoreClock = 64000000U;
+}
