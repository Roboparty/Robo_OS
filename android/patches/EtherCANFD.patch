diff --git a/rtthread/applications/main.c b/rtthread/applications/main.c
new file mode 100644
index 0000000..9b36a19
--- /dev/null
+++ b/rtthread/applications/main.c
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include <rtthread.h>
+#include "ecat_slv.h"
+#include "esc_port.h"
+#include "gateway.h"
+#include "pdo.h"
+#include "sync_guard.h"
+#ifdef ETHERCANFD_USB
+#include "gs_usb_port.h"
+#endif
+
+int main(void)
+{
+#ifdef ETHERCANFD_USB
+    if (gs_usb_boot_selected()) {
+        app_init_led_pins();
+        rt_kprintf("EtherCANFD: HPM6E80 / RT-Thread / gs_usb (MCAN4)\n");
+        gs_usb_run();
+        return 0;
+    }
+#endif
+    rt_kprintf("EtherCANFD: HPM6E80 / RT-Thread / SOES (PDI events)\n");
+    if (hpm_soes_init() != RT_EOK) {
+        rt_kprintf("ESC startup timed out; gateway not started\n");
+        return -1;
+    }
+    esc_cfg_t config = {
+        .use_interrupt = 1,
+        .watchdog_cnt = 100,
+        .application_hook = gateway_poll,
+        .safeoutput_override = gateway_stop,
+        .skip_default_initialization = true,
+        .rxpdo_override = gateway_rxpdo,
+        .txpdo_override = gateway_txpdo,
+        .pre_object_download_hook = gateway_validate_sdo,
+        .post_object_download_hook = gateway_apply_sdo,
+        .esc_hw_eep_handler = hpm_soes_eeprom,
+        .esc_hw_interrupt_enable = hpm_soes_irq_enable,
+        .esc_hw_interrupt_disable = hpm_soes_irq_disable,
+        .esc_check_dc_handler = hpm_soes_check_dc,
+    };
+    ecat_slv_init(&config);
+    gateway_init();
+    hpm_soes_irq_enable(ESCREG_ALEVENT_CONTROL | ESCREG_ALEVENT_SMCHANGE |
+        ESCREG_ALEVENT_SM0 | ESCREG_ALEVENT_SM1 | ESCREG_ALEVENT_EEP | ESCREG_ALEVENT_WD);
+    uint32_t previous = hpm_soes_time_us();
+    uint32_t last_sequence = 0;
+    struct sync_guard guard = {0};
+    for (;;) {
+        ecat_slv_poll();
+        uint32_t pulse_us;
+        uint32_t sequence = hpm_soes_sync_snapshot(&pulse_us);
+        uint32_t now = hpm_soes_time_us();
+        uint32_t elapsed_ms = (now - previous) / 1000;
+        if (elapsed_ms) {
+            if (elapsed_ms >= 100 && (ESCvar.App.state & APPSTATE_OUTPUT)) {
+                ESC_ALstatusgotoerror(ESCsafeop | ESCerror, ALERR_WATCHDOG);
+            }
+            for (unsigned i = 0; i < elapsed_ms && i < 100; ++i)
+                DIG_process(DIG_PROCESS_WD_FLAG);
+            previous += elapsed_ms * 1000;
+        }
+        if (ESCvar.ALevent & ESCREG_ALEVENT_WD) {
+            uint16_t status;
+            ESC_read(ESCREG_WDSTATUS, &status, sizeof(status));
+            if (!(etohs(status) & 1) && (ESCvar.App.state & APPSTATE_OUTPUT))
+                ESC_ALstatusgotoerror(ESCsafeop | ESCerror, ALERR_WATCHDOG);
+        }
+        bool dc = ESCvar.dcsync != 0;
+        bool sync = sequence != last_sequence;
+        if (ESCvar.App.state & APPSTATE_OUTPUT) {
+            uint8_t activation;
+            ESC_read(ESCREG_SYNC_ACT, &activation, sizeof(activation));
+            bool active = (activation & (ESCREG_SYNC_ACT_ACTIVATED |
+                                        ESCREG_SYNC_AUTO_ACTIVATED)) != 0;
+            uint32_t ns = 0;
+            if (dc) ESC_read(ESCREG_SYNC0_CYCLE_TIME, &ns, sizeof(ns));
+            if (active != dc || (dc && (activation != 3 ||
+                    etohl(ns) != hpm_soes_cycle_us * 1000)))
+                ESC_ALstatusgotoerror(ESCsafeop | ESCerror, ALERR_DCINVALIDSYNCCFG);
+        }
+        if (dc && !sync_guard_update(&guard, now, sequence, pulse_us,
+                hpm_soes_cycle_us, (ESCvar.ALevent & ESCREG_ALEVENT_SM2) != 0,
+                (ESCvar.App.state & APPSTATE_OUTPUT) != 0)) {
+            ESC_ALstatusgotoerror(ESCsafeop | ESCerror, ALERR_SYNCERROR);
+        }
+        if (!dc) guard = (struct sync_guard){sequence, now, 0, false};
+        last_sequence = sequence;
+        uint8_t flags = DIG_PROCESS_APP_HOOK_FLAG;
+        if (!dc || sync)
+            flags |= DIG_PROCESS_OUTPUTS_FLAG | DIG_PROCESS_INPUTS_FLAG;
+        DIG_process(flags);
+        hpm_soes_wait();
+    }
+}
diff --git a/rtthread/applications/object_dictionary.c b/rtthread/applications/object_dictionary.c
new file mode 100644
index 0000000..b3e624c
--- /dev/null
+++ b/rtthread/applications/object_dictionary.c
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "object_dictionary.h"
+#include "esc_coe.h"
+#include <string.h>
+#include <assert.h>
+
+void *od_data(uint16_t index, uint8_t subindex, size_t size)
+{
+    for (const _objectlist *obj = SDOobjects; obj->index != 0xffff; ++obj) {
+        if (obj->index != index) continue;
+        for (unsigned i = 0; i <= obj->maxsub; ++i) {
+            const _objd *entry = &obj->objdesc[i];
+            if (entry->subindex == subindex && (entry->bitlength + 7u) / 8u == size)
+                return entry->data;
+        }
+    }
+    return NULL;
+}
+
+uint32_t od_get(uint16_t index, uint8_t subindex)
+{
+    for (size_t size = 1; size <= 4; size *= 2) {
+        const uint8_t *data = od_data(index, subindex, size);
+        if (!data) continue;
+        uint32_t value = 0;
+        for (size_t i = 0; i < size; ++i) value |= (uint32_t)data[i] << (8 * i);
+        return value;
+    }
+    assert(0);
+    return 0;
+}
+
+void od_set(uint16_t index, uint8_t subindex, uint32_t value)
+{
+    for (size_t size = 1; size <= 4; size *= 2) {
+        uint8_t *data = od_data(index, subindex, size);
+        if (!data) continue;
+        for (size_t i = 0; i < size; ++i) data[i] = value >> (8 * i);
+        return;
+    }
+    assert(0);
+}
