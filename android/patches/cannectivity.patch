diff --git a/scripts/stm32-fs-matrix.py b/scripts/stm32-fs-matrix.py
new file mode 100644
index 0000000..9719932
--- /dev/null
+++ b/scripts/stm32-fs-matrix.py
@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Build and inspect the Nucleo USB FS matrix. Does not access hardware."""
+
+import argparse
+import hashlib
+import json
+import pickle
+from pathlib import Path
+import subprocess
+import sys
+
+import yaml
+from elftools.elf.elffile import ELFFile
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def pinmux_values(node):
+    """Flatten STM32 pinctrl groups from the generated devicetree."""
+    if "pinmux" in node.props:
+        value = node.props["pinmux"].val
+        yield from [value] if isinstance(value, int) else value
+    for child in node.children.values():
+        yield from pinmux_values(child)
+
+
+def check_g5_pins(edt, descriptor):
+    package = json.loads(descriptor.read_text())
+    available = {pad.split("(", 1)[0] for pad in package["die_pads"]}
+    valid = {}
+    for signal in package["signals"]:
+        function = signal["function"]
+        if function["type"] == "alternate":
+            mode = int(function["id"].removeprefix("AF"))
+        elif function["type"] == "additional" and signal["name"] in ("USB_DM", "USB_DP"):
+            mode = 16  # STM32_ANALOG: USB uses the dedicated pad function.
+        else:
+            continue
+        valid.setdefault(signal["name"], set()).add((signal["die_pad"].split("(", 1)[0], mode))
+
+    used = {}
+    result = {}
+    for label, signals in [
+        ("fdcan1", ("FDCAN1_RX", "FDCAN1_TX")),
+        ("fdcan2", ("FDCAN2_RX", "FDCAN2_TX")),
+        ("fdcan3", ("FDCAN3_RX", "FDCAN3_TX")),
+        ("zephyr_udc0", ("USB_DM", "USB_DP")),
+    ]:
+        node = edt.label2node[label]
+        pins = [value for group in node.props["pinctrl-0"].val for value in pinmux_values(group)]
+        matched = set()
+        for value in pins:
+            # Encoding from zephyr/dt-bindings/pinctrl/stm32-pinctrl.h.
+            pad = f"P{chr(65 + ((value >> 9) & 31))}{(value >> 5) & 15}"
+            mode = value & 31
+            if pad not in available:
+                raise ValueError(f"{label}: {pad} is absent from the G5 LQFP64 package")
+            if pad in used:
+                raise ValueError(f"{label}: {pad} is already used by {used[pad]}")
+            candidates = [signal for signal in signals if (pad, mode) in valid.get(signal, set())]
+            if len(candidates) != 1 or candidates[0] in matched:
+                raise ValueError(f"{label}: invalid or duplicate signal on {pad}, mode {mode}")
+            signal = candidates[0]
+            matched.add(signal)
+            used[pad] = signal
+            result[signal] = {"pin": pad, "mode": "analog" if mode == 16 else f"AF{mode}"}
+        if matched != set(signals):
+            raise ValueError(f"{label}: missing pins for {set(signals) - matched}")
+    return result
+
+
+def inspect_build(build, expected_channels):
+    config = dict(
+        line.split("=", 1)
+        for line in (build / "zephyr/.config").read_text().splitlines()
+        if line.startswith("CONFIG_") and "=" in line
+    )
+    for key, value in {
+        "CONFIG_CAN_FD_MODE": "y",
+        "CONFIG_USB_DEVICE_STACK_NEXT": "y",
+        "CONFIG_CANNECTIVITY_TIMESTAMP_COUNTER": "y",
+        "CONFIG_USBD_GS_USB_MAX_CHANNELS": str(expected_channels),
+    }.items():
+        if config.get(key) != value:
+            raise ValueError(f"{key}: expected {value}, got {config.get(key)}")
+
+    # Only load the devicetree generated by this local build.
+    with (build / "zephyr/edt.pickle").open("rb") as stream:
+        edt = pickle.load(stream)
+    usb = edt.label2node["zephyr_udc0"]
+    if usb.status != "okay" or usb.props["maximum-speed"].val != "full-speed":
+        raise ValueError("USB FS controller is not enabled")
+    channels = edt.compat2okay["cannectivity-channel"]
+    controllers = [node.props["can-controller"].val for node in channels]
+    if len(controllers) != expected_channels or len(set(controllers)) != expected_channels:
+        raise ValueError("Missing or duplicate CAN channels")
+    clocks = []
+    for controller in controllers:
+        if controller.status != "okay":
+            raise ValueError(f"{controller.path} is disabled")
+        clocks.append((
+            [clock.data for clock in controller.props["clocks"].val],
+            controller.props["clk-divider"].val if "clk-divider" in controller.props else 1,
+        ))
+    if any(clock != clocks[0] for clock in clocks):
+        raise ValueError("FDCAN controllers disagree on their shared kernel clock")
+
+    with (build / "zephyr/zephyr.elf").open("rb") as stream:
+        elf = ELFFile(stream)
+        symbols = {s.name: s["st_value"] for s in elf.get_section_by_name(".symtab").iter_symbols()}
+    ram = edt.chosen_node("zephyr,sram").regs[0]
+    flash = edt.chosen_node("zephyr,flash").regs[0]
+    ram_used = symbols["_image_ram_end"] - symbols["_image_ram_start"]
+    if not (ram.addr <= symbols["_image_ram_start"] <= symbols["_image_ram_end"] <= ram.addr + ram.size):
+        raise ValueError("Linked RAM image is outside the chosen SRAM region")
+    if not 0 < symbols["_flash_used"] <= flash.size:
+        raise ValueError("Linked Flash image exceeds the chosen Flash region")
+    result = {
+        "channels": len(channels),
+        "usb_speed": "full-speed",
+        "flash_used_bytes": symbols["_flash_used"],
+        "ram_used_bytes": ram_used,
+        "application_ram_region_bytes": ram.size,
+        "ram_unallocated_bytes": ram.size - ram_used,
+        "flash_region_bytes": flash.size,
+        "elf_sha256": hashlib.sha256((build / "zephyr/zephyr.elf").read_bytes()).hexdigest(),
+        "elf": str(build / "zephyr/zephyr.elf"),
+        "hardware_tested": False,
+    }
+    if config.get("CONFIG_SOC_STM32G564XX") == "y":
+        cache = dict(
+            line.split("=", 1) for line in (build / "CMakeCache.txt").read_text().splitlines()
+            if line.startswith("STM32G5_DFP_DIR:PATH=")
+        )
+        descriptor = Path(cache["STM32G5_DFP_DIR:PATH"]) / "Descriptors/pinout/STM32G5(5-6)4R(B-C-E)Tx(Z-_)_pinout.json"
+        result["validated_pins"] = check_g5_pins(edt, descriptor)
+        result["pin_descriptor_sha256"] = hashlib.sha256(descriptor.read_bytes()).hexdigest()
+    return result
+
+
+def main():
+    matrix = yaml.safe_load((ROOT / "app/tests.yaml").read_text())["tests"][
+        "app.cannectivity.stm32_fs"
+    ]["integration_platforms"]
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--workspace", type=Path, required=True)
+    parser.add_argument("--build-root", type=Path, required=True)
+    parser.add_argument("--board", action="append", choices=matrix)
+    parser.add_argument("--inspect-only", action="store_true")
+    parser.add_argument("--g5-dfp", type=Path, help="Override STM32G5 device pack directory")
+    parser.add_argument("--g5-drivers", type=Path, help="Override STM32G5 HAL2 directory")
+    args = parser.parse_args()
+    workspace = args.workspace.resolve()
+    output = args.build_root.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    sys.path.insert(0, str(workspace / "zephyr/scripts/dts/python-devicetree/src"))
+    modules = [workspace / "modules/hal/cmsis_6", workspace / "modules/hal/stm32", ROOT]
+    report = {}
+    failed = False
+    for board in args.board or matrix:
+        build = output / board
+        try:
+            if not args.inspect_only:
+                sdk_args = []
+                if board == "nucleo_g564re":
+                    if args.g5_dfp:
+                        sdk_args.append(f"-DSTM32G5_DFP_DIR={args.g5_dfp.resolve()}")
+                    if args.g5_drivers:
+                        sdk_args.append(f"-DSTM32G5_DRIVERS_DIR={args.g5_drivers.resolve()}")
+                with (output / f"{board}.log").open("w") as log:
+                    subprocess.run([
+                        "west", "build", "-p", "always", "-b", board,
+                        str(ROOT / "app"), "-d", str(build), "--",
+                        "-DZEPHYR_MODULES=" + ";".join(map(str, modules)),
+                        *sdk_args,
+                    ], cwd=workspace, stdout=log, stderr=subprocess.STDOUT, check=True)
+            report[board] = inspect_build(build, 3 if board in ("nucleo_g474re", "nucleo_g564re") else 2)
+            print(f"{board}: {json.dumps(report[board])}", flush=True)
+        except (subprocess.CalledProcessError, OSError, ValueError, KeyError) as error:
+            report[board] = {"error": str(error)}
+            print(f"{board}: FAILED: {error}; see {output / (board + '.log')}", flush=True)
+            failed = True
+    (output / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+    return int(failed)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/soc/roboparty/stm32g5x/CMakeLists.txt b/soc/roboparty/stm32g5x/CMakeLists.txt
new file mode 100644
index 0000000..bd788fe
--- /dev/null
+++ b/soc/roboparty/stm32g5x/CMakeLists.txt
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: Apache-2.0
+set(STM32G5_DFP_DIR "${WEST_TOPDIR}/modules/hal/stm32g5xx-dfp" CACHE PATH "STM32G5 device pack")
+set(STM32G5_DRIVERS_DIR "${WEST_TOPDIR}/modules/hal/stm32g5xx-drivers" CACHE PATH "STM32G5 HAL2")
+foreach(path ${STM32G5_DFP_DIR}/Include/stm32g5xx.h
+             ${STM32G5_DRIVERS_DIR}/hal/stm32g5xx_hal_pcd.c)
+  if(NOT EXISTS "${path}")
+    message(FATAL_ERROR "Missing G5 SDK file: ${path}. Set STM32G5_DFP_DIR and STM32G5_DRIVERS_DIR.")
+  endif()
+endforeach()
+
+set(g5_wrappers ${CMAKE_CURRENT_BINARY_DIR}/include)
+file(MAKE_DIRECTORY ${g5_wrappers})
+foreach(header bus cortex crs dma exti flash gpio pwr rcc system tim utils)
+  file(WRITE ${g5_wrappers}/stm32_ll_${header}.h "#include <stm32g5xx_ll_${header}.h>\n")
+endforeach()
+file(APPEND ${g5_wrappers}/stm32_ll_pwr.h
+  "#define LL_PWR_EnableVDDUSB LL_PWR_EnableUSBSupply\n#define LL_PWR_DisableVDDUSB LL_PWR_DisableUSBSupply\n")
+# Extend the upstream dispatch in a build-local copy, preserving its ABI and helpers.
+set(clock_header zephyr/drivers/clock_control/stm32_clock_control.h)
+file(READ ${ZEPHYR_BASE}/include/${clock_header} clock_api)
+set(dispatch "#elif defined(CONFIG_SOC_SERIES_STM32G4X)")
+string(FIND "${clock_api}" "${dispatch}" dispatch_pos)
+if(dispatch_pos EQUAL -1)
+  message(FATAL_ERROR "STM32 clock header changed; review the G5 dispatch adapter")
+endif()
+string(REPLACE "${dispatch}"
+  "#elif defined(CONFIG_SOC_SERIES_STM32G5X)\n#include <zephyr/dt-bindings/clock/stm32_common_clocks.h>\n${dispatch}"
+  clock_api "${clock_api}")
+file(MAKE_DIRECTORY ${g5_wrappers}/zephyr/drivers/clock_control)
+file(WRITE ${g5_wrappers}/${clock_header} "${clock_api}")
+target_include_directories(zephyr_interface BEFORE INTERFACE ${g5_wrappers})
+zephyr_include_directories(.
+  ${STM32G5_DFP_DIR}/Include ${STM32G5_DFP_DIR}/Include/Templates
+  ${STM32G5_DRIVERS_DIR}/hal ${STM32G5_DRIVERS_DIR}/ll
+  ${STM32G5_DRIVERS_DIR}/templates/common
+  ${ZEPHYR_BASE}/soc/st/stm32/common ${ZEPHYR_BASE}/drivers)
+zephyr_compile_definitions(STM32G564xx USE_HAL_DRIVER USE_FULL_LL_DRIVER)
+zephyr_sources(soc.c clock.c
+  ${STM32G5_DFP_DIR}/Source/Templates/system_stm32g5xx.c
+  ${STM32G5_DRIVERS_DIR}/hal/stm32g5xx_hal.c
+  ${STM32G5_DRIVERS_DIR}/hal/stm32g5xx_hal_rcc.c
+  ${STM32G5_DRIVERS_DIR}/hal/stm32g5xx_hal_pcd.c
+  ${STM32G5_DRIVERS_DIR}/hal/stm32g5xx_usb_drd_core.c
+  ${ZEPHYR_BASE}/soc/st/stm32/common/stm32cube_hal.c
+  ${ZEPHYR_BASE}/soc/st/stm32/common/gpioport_mgr.c)
+set(SOC_LINKER_SCRIPT ${ZEPHYR_BASE}/include/zephyr/arch/arm/cortex_m/scripts/linker.ld CACHE INTERNAL "")
