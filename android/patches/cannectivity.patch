+/* SPDX-License-Identifier: Apache-2.0 */
+/dts-v1/;
+#include <arm/armv8-m.dtsi>
+#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>
+#include <zephyr/dt-bindings/clock/stm32_common_clocks.h>
+#include <freq.h>
+#include <mem.h>
+
+/ {
+	model = "STMicroelectronics NUCLEO-G564RE";
+	compatible = "st,stm32g564re-nucleo";
+	chosen {
+		zephyr,sram = &sram0;
+		zephyr,flash = &flash0;
+		zephyr,canbus = &fdcan1;
+	};
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		cpu0: cpu@0 {
+			#address-cells = <1>;
+			#size-cells = <1>;
