+			};
+			can1_rx: can1-rx { pinmux = <STM32_PINMUX('A', 6, AF9)>; };
+			can1_tx: can1-tx { pinmux = <STM32_PINMUX('A', 7, AF9)>; slew-rate = "very-high-speed"; };
+			can2_rx: can2-rx { pinmux = <STM32_PINMUX('A', 4, AF13)>; };
