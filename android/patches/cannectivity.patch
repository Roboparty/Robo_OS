@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "stm32_fs_dual.dtsi"
+
+/* Nucleo PLL2 Q = 160 MHz, shared FDCAN divider = 2. */
+&fdcan1 { clk-divider = <2>; };
+&fdcan2 {
+	pinctrl-0 = <&fdcan2_rx_pb12 &fdcan2_tx_pa10>;
+	clocks = <&rcc STM32_CLOCK(APB1_2, 9)>,
+		 <&rcc STM32_SRC_PLL2_Q FDCAN_SEL(2)>;
+	clk-divider = <2>;
+};
+&timers2 { st,prescaler = <239>; };
+&i2c1 { status = "disabled"; };
+/* Ethernet is unused; avoid requiring its pinctrl naming across HAL revisions. */
+&mac {
+	status = "disabled";
+	/delete-property/ pinctrl-0;
+	/delete-property/ pinctrl-names;
+};
+&mdio { status = "disabled"; };
diff --git a/app/boards/nucleo_u3c5zi_q_stm32u3c5xx.overlay b/app/boards/nucleo_u3c5zi_q_stm32u3c5xx.overlay
new file mode 100644
index 0000000..f39e4b6
--- /dev/null
+++ b/app/boards/nucleo_u3c5zi_q_stm32u3c5xx.overlay
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+/* STM32U3C5 CMSIS: FDCAN2 base 0x4000a800, IRQs 114/115.
+ * Supply the instance missing from Zephyr's STM32U3C5 device tree.
+ */
+/ {
+	soc {
+		fdcan2: can@4000a800 {
+			compatible = "st,stm32-fdcan";
+			reg = <0x4000a800 0x400>, <0x4000ac00 0x6a0>;
+			reg-names = "m_can", "message_ram";
+			interrupts = <114 0>, <115 0>;
+			interrupt-names = "int0", "int1";
+			clocks = <&rcc STM32_CLOCK(APB1_2, 9)>;
+			bosch,mram-cfg = <0x350 28 8 3 3 0 3 3>;
+		};
+	};
+};
+
+#include "stm32_fs_dual.dtsi"
+
+/* The Q package does not expose PB12 as FDCAN2 RX. */
+&fdcan2 {
+	pinctrl-0 = <&fdcan2_rx_pb5 &fdcan2_tx_pb13>;
+	clocks = <&rcc STM32_CLOCK(APB1_2, 9)>, <&rcc STM32_SRC_SYSCLK FDCAN1_SEL(0)>;
+	clk-divider = <1>;
+};
+&fdcan1 {
+	clocks = <&rcc STM32_CLOCK(APB1_2, 9)>, <&rcc STM32_SRC_SYSCLK FDCAN1_SEL(0)>;
+	clk-divider = <1>;
+};
+&timers2 { st,prescaler = <95>; };
+&pwm2 { status = "disabled"; };
+/* TIM2 supplies timestamps; the RTC counter driver is not needed. */
+&rtc { status = "disabled"; };
