+#include "can_irq_dispatch.h"
+
+static can_irq_handler_t can_handler;
+static void ethercanfd_mcan4_irq(void)
+{
+    if (can_handler) can_handler(0);
+}
+SDK_DECLARE_EXT_ISR_M(IRQn_MCAN4, ethercanfd_mcan4_irq)
+
+void can_irq_set_handler(can_irq_handler_t handler)
+{
+    rt_base_t level = rt_hw_interrupt_disable();
+    can_handler = handler;
+    rt_hw_interrupt_enable(level);
+}
