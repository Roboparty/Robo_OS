+/* SPDX-License-Identifier: GPL-3.0-only */
+#ifndef ETHERCANFD_GS_USB_PORT_H
+#define ETHERCANFD_GS_USB_PORT_H
+#include <rtthread.h>
+#include "can_port.h"
+#include "rtt_board.h"
+#include "hpm_gpio_drv.h"
+
+static inline bool gs_usb_boot_selected(void)
+{
+#ifdef ETHERCANFD_BOOT_USB
+    return true;
+#elif defined(ETHERCANFD_BOOT_AUTO)
+    board_init_gpio_pins();
+    gpio_set_pin_input(BOARD_APP_GPIO_CTRL, BOARD_APP_GPIO_INDEX, BOARD_APP_GPIO_PIN);
+    for (unsigned i = 0; i < 20; ++i) {
+        if (gpio_read_pin(BOARD_APP_GPIO_CTRL, BOARD_APP_GPIO_INDEX,
+                          BOARD_APP_GPIO_PIN) != BOARD_BUTTON_PRESSED_VALUE)
+            return false;
+        rt_thread_mdelay(1);
+    }
+    return true;
+#else
+    return false;
+#endif
+}
+
+static inline void board_led_mode_on(void) { app_led_write(APP_LED0, APP_LED_ON); }
+static inline void board_led_mode_off(void) { app_led_write(APP_LED0, APP_LED_OFF); }
+static inline void board_led_usb_off(void) { app_led_write(APP_LED1, APP_LED_OFF); }
+static inline void board_led_usb_toggle(void)
+{
+    static bool state;
+    state = !state;
+    app_led_write(APP_LED1, state ? APP_LED_ON : APP_LED_OFF);
+}
+static inline void board_led_can_on(unsigned ch)
+{
+    if (ch == 0) app_led_write(APP_LED2, APP_LED_ON);
+}
+static inline void board_led_can_off(unsigned ch)
+{
+    if (ch == 0) app_led_write(APP_LED2, APP_LED_OFF);
+}
+void gs_usb_run(void);
+#endif
diff --git a/scripts/build_rtthread.py b/scripts/build_rtthread.py
new file mode 100644
index 0000000..4c7bd64
--- /dev/null
+++ b/scripts/build_rtthread.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Build the HPM6E80 RT-Thread target in an isolated workspace."""
+import argparse
+import json
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def run(*args, **kwargs):
+    subprocess.run(args, check=True, **kwargs)
+
+
+def check_interrupt_vectors(bsp, toolchain, usb):
+    elf = bsp / 'rtthread.elf'
+    prefix = toolchain.resolve() / 'riscv32-unknown-elf-'
+    symbols = {}
+    for line in subprocess.check_output([str(prefix) + 'nm', str(elf)], text=True).splitlines():
+        fields = line.split()
+        if len(fields) == 3:
+            symbols[fields[2]] = int(fields[0], 16)
+    vectors = bsp / 'irq-vectors.bin'
+    run(str(prefix) + 'objcopy', '--dump-section', f'.vectors={vectors}', str(elf))
+    data = vectors.read_bytes()
+    # HPM6E80 IRQ indices from hpm_interrupt.h; .vectors starts at __vector_table.
+    required = {133: 'ESC', 134: 'SYNC0'}
+    if usb:
+        required.update({94: 'MCAN4', 127: 'USB0'})
+    for irq, name in required.items():
+        handler = symbols[f'default_isr_{irq}']
+        if handler == symbols['default_irq_handler'] or struct.unpack_from('<I', data, irq * 4)[0] != handler:
+            raise RuntimeError(f'{name}: static interrupt vector is not connected')
+    print('HPM6E80 interrupt vectors verified: ' + ', '.join(required.values()))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--workspace', type=Path, required=True,
+                        help='Dependency and build directory (use test/tmp/)')
+    parser.add_argument('--toolchain', type=Path, required=True,
+                        help='Directory containing riscv32-unknown-elf-gcc')
+    parser.add_argument('--fetch', action='store_true', help='Fetch missing pinned dependencies')
+    parser.add_argument('--usb-sdk', type=Path,
+                        help='HPM SDK checkout containing the pinned CherryUSB middleware')
+    parser.add_argument('--mode', choices=('ethercat', 'usb', 'auto'), default='ethercat')
+    parser.add_argument('--dc-sync0', action='store_true',
+                        help='Enable experimental SYNC0 at 1-10 ms periods')
+    parser.add_argument('-j', type=int, default=8)
+    args = parser.parse_args()
+    if args.mode != 'ethercat' and args.usb_sdk is None:
+        parser.error('--mode usb/auto requires --usb-sdk')
+    if args.dc_sync0 and args.mode == 'usb':
+        parser.error('--dc-sync0 requires ethercat or auto mode')
+    if args.usb_sdk:
+        args.usb_sdk = args.usb_sdk.resolve()
+        revision = subprocess.check_output(
+            ['git', '-C', str(args.usb_sdk), 'rev-parse', 'HEAD'], text=True).strip()
+        if revision != 'ccc5ec467a047f3ea85cd2fa4565e91db7135a38':
+            parser.error('USB middleware requires HPM SDK ccc5ec467a047f3ea85cd2fa4565e91db7135a38')
+        run('git', '-C', str(args.usb_sdk), 'diff', '--quiet', 'HEAD', '--', 'middleware/cherryusb')
+    workspace = args.workspace.resolve()
+    workspace.mkdir(parents=True, exist_ok=True)
+    pins = json.loads((ROOT / 'rtthread/dependencies.json').read_text())
+    for name, pin in pins.items():
+        checkout = workspace / name
+        if not checkout.exists() and args.fetch:
+            run('git', 'init', str(checkout))
+            run('git', '-C', str(checkout), 'remote', 'add', 'origin', pin['url'])
+            run('git', '-C', str(checkout), 'fetch', '--depth', '1', '--filter=blob:none', 'origin', pin['revision'])
+            if name == 'rt-thread':
+                run('git', '-C', str(checkout), 'sparse-checkout', 'set',
+                    'bsp/hpmicro', 'components', 'include', 'libcpu', 'src', 'tools')
+            run('git', '-C', str(checkout), 'checkout', '--detach', 'FETCH_HEAD')
+        if not checkout.exists():
+            parser.error(f'{checkout} missing; supply --fetch')
+        actual = subprocess.check_output(['git', '-C', str(checkout), 'rev-parse', 'HEAD'], text=True).strip()
+        if actual != pin['revision']:
+            parser.error(f'{name}: expected {pin["revision"]}, found {actual}')
+        run('git', '-C', str(checkout), 'diff', '--quiet', 'HEAD', '--')
+
+    rtt = workspace / 'rt-thread'
+    bsp = workspace / 'build-hpm6e80'
+    marker = bsp / '.ethercanfd-workspace'
+    if bsp.exists() and not marker.exists():
+        parser.error(f'refusing to overwrite unowned directory {bsp}')
+    bsp.mkdir(exist_ok=True)
+    marker.touch()
+    shutil.copytree(rtt / 'bsp/hpmicro/hpm6e00evk', bsp, dirs_exist_ok=True,
+                    ignore=shutil.ignore_patterns('applications', '*.md', '.gitignore'))
+    for dest, source in [('libraries', rtt / 'bsp/hpmicro/libraries'),
+                         ('packages/hpm_sdk-v1.13.0', workspace / 'hpm-sdk')]:
+        target = bsp / dest
+        target.parent.mkdir(parents=True, exist_ok=True)
+        if not target.exists():
+            target.symlink_to(source, target_is_directory=True)
+    (bsp / 'packages/SConscript').write_text(
+        "from building import *\nobjs = SConscript('hpm_sdk-v1.13.0/SConscript')\nReturn('objs')\n")
+    if (bsp / 'applications').exists():
+        shutil.rmtree(bsp / 'applications')
+    shutil.copytree(ROOT / 'rtthread/applications', bsp / 'applications')
+    shutil.copytree(ROOT / 'rtthread/port', bsp / 'applications/port', dirs_exist_ok=True)
+    if args.usb_sdk:
+        shared = bsp / 'applications/usb'
+        shared.mkdir()
+        for name in ('gs_usb.c', 'gs_usb_time.h', 'usb_config.h', 'can_irq_dispatch.h'):
+            shutil.copy2(ROOT / 'src' / name, shared / name)
+        (shared / 'version.h').write_text('#define FIRMWARE_VERSION "1.2.0-rtt"\n')
+        shutil.copytree(args.usb_sdk / 'middleware/cherryusb',
+                        bsp / 'applications/cherryusb',
+                        ignore=shutil.ignore_patterns('*.o', '*.md'))
+    config = (bsp / 'rtconfig.h').read_text()
+    config = config.replace('#define RT_MAIN_THREAD_STACK_SIZE 2048', '#define RT_MAIN_THREAD_STACK_SIZE 8192')
+    config = config.replace('#endif', (ROOT / 'rtthread/config.h').read_text() + '\n#endif')
+    if args.usb_sdk:
+        config += ('\n#define ETHERCANFD_USB\n#define ETHERCANFD_RTTHREAD\n'
+                   '#define BSP_USING_USB\n#define BSP_USING_USB_DEVICE\n'
+                   '#define GS_USB_CAN_CHANNEL_COUNT 1U\n')
+    if args.mode == 'usb':
+        config += '#define ETHERCANFD_BOOT_USB\n'
+    elif args.mode == 'auto':
+        config += '#define ETHERCANFD_BOOT_AUTO\n'
+    if args.dc_sync0:
+        config += '#define ETHERCANFD_DC_SYNC0\n'
+    (bsp / 'rtconfig.h').write_text(config)
+    generated = bsp / 'applications/generated'
+    run(sys.executable, str(ROOT / 'scripts/generate_soes.py'),
+        str(ROOT / 'SSC/EtherCANFD.xml'), str(generated),
+        *(['--dc-sync0'] if args.dc_sync0 else []))
+    environment = dict(os.environ, RTT_ROOT=str(rtt),
+                       RTT_RISCV_TOOLCHAIN=str(args.toolchain.resolve()),
+                       SOES_ROOT=str(workspace / 'SOES'))
+    if args.usb_sdk:
+        environment['CHERRYUSB_ROOT'] = str(bsp / 'applications/cherryusb')
+        environment['HPM_SDK_ROOT'] = str(workspace / 'hpm-sdk')
+    compiler_tmp = workspace / 'compiler-tmp'
+    compiler_tmp.mkdir(exist_ok=True)
+    environment['TMPDIR'] = str(compiler_tmp)
+    sconstruct = bsp / 'SConstruct'
+    sconstruct.write_text(sconstruct.read_text().replace(
+        "env.PrependENVPath('PATH', rtconfig.EXEC_PATH)",
+        "env.PrependENVPath('PATH', rtconfig.EXEC_PATH)\n"
+        "env['ENV']['TMPDIR'] = os.environ['TMPDIR']"))
+    run('scons', f'-j{args.j}', cwd=bsp, env=environment)
+    check_interrupt_vectors(bsp, args.toolchain, args.usb_sdk is not None)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/scripts/check_soes.py b/scripts/check_soes.py
new file mode 100644
index 0000000..2f6d8e9
--- /dev/null
+++ b/scripts/check_soes.py
@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+"""Validate generated ESI/SII and run native PDO tests against pinned SOES."""
+import argparse
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import xml.etree.ElementTree as ET
+sys.dont_write_bytecode = True
+from generate_soes import generate
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--soes', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True, help='Test artifacts under test/tmp/')
+    parser.add_argument('--dc-sync0', action='store_true')
+    args = parser.parse_args()
+    output = args.output.resolve()
+    generate(ROOT / 'SSC/EtherCANFD.xml', output, args.dc_sync0)
+    environment = dict(os.environ, TMPDIR=str(output))
+    sii = (output / 'ethercanfd-sii.bin').read_bytes()
+    assert len(sii) == 2048
+    crc = 0xff
+    for value in sii[:14]:
+        for bit in range(7, -1, -1):
+            carry = ((crc >> 7) ^ (value >> bit)) & 1
+            crc = ((crc << 1) ^ (7 if carry else 0)) & 0xff
+    assert sii[14:16] == bytes([crc, 0])
+    assert struct.unpack_from('<III', sii, 16) == (0x11bc, 1, 1)
+    assert struct.unpack_from('<HHHH', sii, 0x30) == (0x1000, 128, 0x1080, 128)
+    categories = {}
+    offset = 128
+    while struct.unpack_from('<H', sii, offset)[0] != 0xffff:
+        kind, words = struct.unpack_from('<HH', sii, offset)
+        offset += 4
+        categories[kind] = sii[offset:offset + words * 2]
+        offset += words * 2
+    assert len(categories[41]) == 32
+    for kind, index, sm in [(50, 0x1a00, 3), (51, 0x1600, 2)]:
+        assert struct.unpack_from('<HBB', categories[kind]) == (index, 32, sm)
+        assert sum(categories[kind][i + 5] for i in range(8, len(categories[kind]), 8)) == 288 * 8
+    generated = ET.parse(output / 'EtherCANFD.xml')
+    if args.dc_sync0:
+        modes = generated.findall('.//Device/Dc/OpMode')
+        assert [m.findtext('AssignActivate') for m in modes] == ['#x0', '#x300']
+        assert modes[1].find('CycleTimeSync1') is None
+    else:
+        assert generated.find('.//Device/Dc') is None
+    assert generated.find('.//Device/Mailbox/FoE') is None
+    soes = args.soes.resolve() / 'soes'
+    app = ROOT / 'rtthread/applications'
+    binary = output / 'check_soes'
+    command = ['gcc', '-std=gnu11', '-g', '-O1', '-fsanitize=address,undefined',
+               '-DEXPECT_DC_SYNC0=' + str(int(args.dc_sync0)),
+               '-fno-omit-frame-pointer', '-fno-pie', '-no-pie',
+               '-ffunction-sections', '-fdata-sections', '-Wl,--gc-sections',
+               '-I' + str(soes), '-I' + str(soes / 'include/sys/gcc'),
+               '-I' + str(output), '-I' + str(app),
+               str(ROOT / 'rtthread/check_soes.c'), str(app / 'object_dictionary.c'),
+               str(app / 'pdo.c'), str(output / 'objectlist.c'),
+               str(soes / 'esc_coe.c'), '-o', str(binary)]
+    subprocess.run(command, check=True, env=environment)
+    subprocess.run([str(binary)], check=True)
+    sync_binary = output / 'check_sync'
+    subprocess.run(['gcc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                    '-fsanitize=address,undefined', '-fno-pie', '-no-pie',
+                    '-I' + str(app), str(ROOT / 'rtthread/check_sync.c'),
+                    '-o', str(sync_binary)], check=True, env=environment)
+    subprocess.run([str(sync_binary)], check=True)
+    print('SII CRC, identity, mailbox, SM and PDO categories passed')
+
+
+if __name__ == '__main__':
+    main()
