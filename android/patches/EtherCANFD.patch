new file mode 100644
index 0000000..6179c7b
--- /dev/null
+++ b/scripts/generate_soes.py
@@ -0,0 +1,237 @@
+#!/usr/bin/env python3
+"""Generate SOES object storage, PDO constants and read-only SII from the ESI."""
+import argparse
+import json
+from pathlib import Path
+import struct
+import xml.etree.ElementTree as ET
+
+
+def number(value):
+    return int(value[2:], 16) if value.lower().startswith('#x') else int(value, 0)
+
+
+def generate(source, output, dc_sync0=False):
+    tree = ET.parse(source)
+    root = tree.getroot()
+    device = root.find('./Descriptions/Devices/Device')
+    dictionary = device.find('./Profile/Dictionary')
+    types = {node.findtext('Name'): node for node in dictionary.findall('./DataTypes/DataType')}
+    dtype = {'BOOL': 'BOOLEAN', 'USINT': 'UNSIGNED8', 'UINT': 'UNSIGNED16',
+             'UDINT': 'UNSIGNED32', 'ULINT': 'UNSIGNED64'}
+    declarations = ['/* Generated from ESI; do not edit. */', '#include "esc_coe.h"',
+                    '#include "object_dictionary.h"']
+    objects = []
+    fields = {}
+    for obj in dictionary.findall('./Objects/Object'):
+        index = number(obj.findtext('Index'))
+        type_name = obj.findtext('Type')
+        datatype = types.get(type_name)
+        items = [] if datatype is None else datatype.findall('SubItem')
+        defaults = {item.findtext('Name'): item.findtext('Info/DefaultData', '')
+                    for item in obj.findall('Info/SubItem')}
+        entries = []
+        is_array = False
+        if not items:
+            entries.append((0, obj, obj.findtext('Info/DefaultData', '')))
+        for item in items:
+            nested = types.get(item.findtext('Type'))
+            if nested is not None and nested.find('ArrayInfo') is not None:
+                is_array = True
+                count = number(nested.findtext('ArrayInfo/Elements'))
+                start = number(nested.findtext('ArrayInfo/LBound'))
+                bits = number(nested.findtext('BitSize')) // count
+                raw = bytes.fromhex(defaults.get(item.findtext('Name'), ''))
+                for offset in range(count):
+                    element = ET.fromstring(ET.tostring(item))
+                    element.find('Type').text = nested.findtext('BaseType')
+                    element.find('BitSize').text = str(bits)
+                    name = f'SubIndex {start + offset:03d}'
+                    element.find('Name').text = name
+                    default = defaults.get(name, raw[offset * (bits // 8):(offset + 1) * (bits // 8)].hex())
+                    entries.append((start + offset, element, default))
+            else:
+                entries.append((number(item.findtext('SubIdx')), item,
+                                defaults.get(item.findtext('Name'), '')))
+        descriptors = []
+        for sub, item, default in entries:
+            bits = number(item.findtext('BitSize'))
+            size = (bits + 7) // 8
+            raw = bytes.fromhex(default)
+            if len(raw) > size:
+                raise ValueError(f'{index:04x}:{sub}: default exceeds size')
+            raw = raw.ljust(size, b'\0')
+            if index in (0x1c32, 0x1c33) and sub in (1, 4, 5):
+                value = {1: 0, 4: 5 if dc_sync0 else 1, 5: 1000000}[sub]
+                raw = value.to_bytes(size, 'little')
+                for entry in obj.findall('Info/SubItem'):
+                    if entry.findtext('Name') == item.findtext('Name'):
+                        value = entry.find('Info/DefaultData')
+                        if value is not None:
+                            value.text = raw.hex()
+            type_name = item.findtext('Type')
+            ctype = 'VISIBLE_STRING' if type_name.startswith('STRING(') else dtype[type_name]
+            access = item.findtext('Flags/Access', 'ro')
+            if index in (0x1c32, 0x1c33) and sub == 1:
+                # The current mode follows ESC DC registers, not an SDO selector.
+                item.find('Flags/Access').text = 'ro'
+                item.find('Flags/Access').attrib.pop('WriteRestrictions', None)
+                access = 'ro'
+            attr = 'ATYPE_RO' if access == 'ro' else 'ATYPE_RW'
+            access_node = item.find('Flags/Access')
+            if access_node is not None and access_node.get('WriteRestrictions') == 'PreOP':
+                attr = 'ATYPE_RWpre'
+            mapping = item.findtext('Flags/PdoMapping', '')
+            if 'r' in mapping:
+                attr += ' | ATYPE_RXPDO'
+            if 't' in mapping:
+                attr += ' | ATYPE_TXPDO'
+            symbol = f'od_{index:04x}_{sub:02x}'
+            # Native integer alignment is required by SOES expedited SDO accesses.
+            declarations.append(f'static uint8_t {symbol}[{max(size, 1)}] CC_ALIGNED(8) = {{' +
+                                ', '.join(f'0x{x:02x}' for x in raw) + '};')
+            descriptors.append(f'    {{{sub}, DTYPE_{ctype}, {bits}, {attr}, '
+                               f'{json.dumps(item.findtext("Name"))}, {int.from_bytes(raw[:4], "little")}, {symbol}}},')
+            fields[index, sub] = (bits, raw)
+        declarations += [f'static const _objd obj_{index:04x}[] = {{', *descriptors, '};']
+        kind = 'OTYPE_ARRAY' if is_array else ('OTYPE_RECORD' if items else 'OTYPE_VAR')
+        objects.append((index, f'    {{0x{index:04x}, {kind}, {len(entries) - 1}, 0, '
+                               f'{json.dumps(obj.findtext("Name"))}, obj_{index:04x}}},'))
+    declarations += ['const _objectlist SDOobjects[] = {',
+                     *(line for _, line in sorted(objects)),
+                     '    {0xffff, 0xff, 0xff, 0xff, NULL, NULL}', '};']
+
+    options = ['/* Generated from ESI; do not edit. */', '#pragma once',
+               '#define USE_FOE 0', '#define USE_EOE 0', '#define MBXBUFFERS 3']
+    sms = device.findall('Sm')
+    for i, sm in enumerate(sms):
+        address = number(sm.get('StartAddress'))
+        size = number(sm.get('DefaultSize'))
+        control = number(sm.get('ControlByte'))
+        if i < 2:
+            options += [f'#define MBX{i}_sma {address}', f'#define MBX{i}_sml {size}',
+                        f'#define MBX{i}_sme {address + size - 1}', f'#define MBX{i}_smc {control}']
+            options += [f'#define MBX{i}_{key}_b MBX{i}_{key}' for key in ('sma', 'sml', 'sme', 'smc')]
+        else:
+            options += [f'#define SM{i}_sma {address}', f'#define SM{i}_smc {control}',
+                        f'#define SM{i}_act 1']
+    options += ['#define MBXSIZE MBX0_sml', '#define MBXSIZEBOOT MBXSIZE']
+    for tag, sm, direction in [('RxPdo', 2, 'RX'), ('TxPdo', 3, 'TX')]:
+        pdos = device.findall(tag)
+        entries = [entry for pdo in pdos for entry in pdo.findall('Entry')]
+        if len(pdos) != 1 or len(entries) != 32:
+            raise ValueError(f'{tag}: expected one fixed PDO with 32 entries')
+        assignment = 0x1c12 if sm == 2 else 0x1c13
+        if int.from_bytes(fields[assignment, 1][1], 'little') != number(pdos[0].findtext('Index')):
+            raise ValueError(f'{tag}: assignment does not match PDO')
+        total = 0
+        for position, entry in enumerate(entries):
+            key = (number(entry.findtext('Index')), number(entry.findtext('SubIndex')))
+            bits = number(entry.findtext('BitLen'))
+            first = 0x7000 if sm == 2 else 0x6000
+            widths = (16, 16, 8, 8, 16, 240, 240, 32)
+            if key != (first + (position // 8) * 16, position % 8 + 1) or bits != widths[position % 8]:
+                raise ValueError(f'{tag}: frame field order or width changed')
+            mapping = number(pdos[0].findtext('Index'))
+            expected = key[0] << 16 | key[1] << 8 | bits
+            if int.from_bytes(fields[mapping, position + 1][1], 'little') != expected:
+                raise ValueError(f'{tag}: object mapping differs from ESI')
+            if fields[key][0] != bits:
+                raise ValueError(f'PDO entry {key} size mismatch')
+            if bits % 8:
+                raise ValueError('The gateway requires byte-aligned PDO entries')
+            total += bits
+        if total != number(sms[sm].get('DefaultSize')) * 8 or total != 288 * 8:
+            raise ValueError(f'{tag}: expected four 72-byte frames')
+        options += [f'#define MAX_MAPPINGS_SM{sm} {len(entries)}',
+                    f'#define MAX_{direction}PDO_SIZE {total // 8}']
+
+    sii = bytearray(128)
+    config = bytes.fromhex(device.findtext('Eeprom/ConfigData'))
+    sii[:len(config)] = config
+    crc = 0xff
+    for value in sii[:14]:
+        crc ^= value
+        for _ in range(8):
+            crc = ((crc << 1) ^ (0x07 if crc & 0x80 else 0)) & 0xff
+    sii[14] = crc
+    for sub, offset in [(1, 16), (2, 20), (3, 24), (4, 28)]:
+        sii[offset:offset + 4] = fields[0x1018, sub][1]
+    struct.pack_into('<HHHH', sii, 0x30,
+                     number(sms[0].get('StartAddress')), number(sms[0].get('DefaultSize')),
+                     number(sms[1].get('StartAddress')), number(sms[1].get('DefaultSize')))
+    struct.pack_into('<H', sii, 0x38, 0x04)  # CoE only
+    capacity = number(device.findtext('Eeprom/ByteSize'))
+    struct.pack_into('<HH', sii, 0x7c, capacity // 128 - 1, 1)
+
+    def category(kind, data):
+        data = bytes(data)
+        data += b'\0' * (len(data) % 2)
+        sii.extend(struct.pack('<HH', kind, len(data) // 2) + data)
+
+    name = device.findtext('Name').encode('ascii')
+    category(10, bytes([1, len(name)]) + name)
+    general = bytearray(32)
+    general[3] = 1  # Name string
+    general[5] = 0x03  # SDO and SDO information; fixed PDO mapping
+    general[12] = 0x11  # Two MII ports
+    category(30, general)
+    category(40, bytes([1, 2, 3]))  # Outputs, inputs, mailbox status
+    category(41, b''.join(struct.pack('<HHBBBB', number(sm.get('StartAddress')),
+                                      number(sm.get('DefaultSize')), number(sm.get('ControlByte')),
+                                      0, 1, i + 1) for i, sm in enumerate(sms)))
+    # PDO entries use the same indexes, widths and order as the ESI.
+    typecodes = {'BOOL': 1, 'USINT': 5, 'UINT': 6, 'UDINT': 7, 'ULINT': 27}
+    for tag, cat, sm in [('TxPdo', 50, 3), ('RxPdo', 51, 2)]:
+        content = bytearray()
+        for pdo in device.findall(tag):
+            entries = pdo.findall('Entry')
+            content += struct.pack('<HBBBBH', number(pdo.findtext('Index')), len(entries), sm, 0, 0, 0)
+            for entry in entries:
+                datatype = entry.findtext('DataType')
+                code = 9 if datatype.startswith('STRING(') else typecodes[datatype]
+                content += struct.pack('<HBBBBH', number(entry.findtext('Index')),
+                                       number(entry.findtext('SubIndex')), 0, code,
+                                       number(entry.findtext('BitLen')), 0)
+        category(cat, content)
+    sii += b'\xff\xff'
+    if len(sii) > capacity:
+        raise ValueError('SII categories exceed EEPROM capacity')
+    sii.extend(b'\xff' * (capacity - len(sii)))
+    output.mkdir(parents=True, exist_ok=True)
+    (output / 'objectlist.c').write_text('\n'.join(declarations) + '\n')
+    (output / 'ecat_options.h').write_text('\n'.join(options) + '\n')
+    (output / 'sii.c').write_text('#include <stdint.h>\nconst uint8_t ethercanfd_sii[] = {\n' +
+        '\n'.join('    ' + ', '.join(f'0x{x:02x}' for x in sii[i:i + 16]) + ','
+                  for i in range(0, len(sii), 16)) + '\n};\n'
+        f'const unsigned ethercanfd_sii_size = {len(sii)};\n')
+    (output / 'ethercanfd-sii.bin').write_bytes(sii)
+    # Only the explicit DC build advertises the implemented SYNC0 mode.
+    dc = device.find('Dc')
+    if dc is not None:
+        device.remove(dc)
+    if dc_sync0:
+        dc = ET.Element('Dc')
+        device.insert(list(device).index(device.find('Eeprom')), dc)
+        for name, assign in [('FreeRun', '#x0'), ('DC-SYNC0', '#x300')]:
+            mode = ET.SubElement(dc, 'OpMode')
+            ET.SubElement(mode, 'Name').text = name
+            ET.SubElement(mode, 'Desc').text = name
+            ET.SubElement(mode, 'AssignActivate').text = assign
+            if assign != '#x0':
+                ET.SubElement(mode, 'CycleTimeSync0', Factor='1').text = '0'
+    foe = device.find('Mailbox/FoE')
+    if foe is not None:
+        device.find('Mailbox').remove(foe)
+    device.find('Mailbox/CoE').set('CompleteAccess', 'false')
+    tree.write(output / 'EtherCANFD.xml', encoding='utf-8', xml_declaration=True)
+    print(f'Generated {len(objects)} objects, 288-byte Rx/Tx PDOs, {capacity}-byte SII')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('esi', type=Path)
+    parser.add_argument('output', type=Path)
+    parser.add_argument('--dc-sync0', action='store_true')
+    args = parser.parse_args()
+    generate(args.esi, args.output, args.dc_sync0)
