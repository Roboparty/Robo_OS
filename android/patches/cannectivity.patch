+			ranges = <0 0x46000000 0x800>;
+			gpioa: gpio@0 {
+				compatible = "st,stm32-gpio";
+				reg = <0 0x400>;
+				gpio-controller;
+				#gpio-cells = <2>;
+				clocks = <&rcc 0x94 0x200>;
+			};
+			gpiob: gpio@400 {
+				compatible = "st,stm32-gpio";
+				reg = <0x400 0x400>;
