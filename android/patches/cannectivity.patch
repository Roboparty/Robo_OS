+			usb_dm: usb-dm { pinmux = <STM32_PINMUX('A', 11, ANALOG)>; };
+			usb_dp: usb-dp { pinmux = <STM32_PINMUX('A', 12, ANALOG)>; };
+		};
+		fdcan1: can@4000a000 {
+			compatible = "st,stm32-fdcan";
+			reg = <0x4000a000 0x400>, <0x4000ac00 0x350>;
+			reg-names = "m_can", "message_ram";
+			interrupts = <46 0>, <47 0>;
