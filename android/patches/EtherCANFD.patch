diff --git a/rtthread/port/esc_hw.c b/rtthread/port/esc_hw.c
new file mode 100644
index 0000000..9bf816d
--- /dev/null
+++ b/rtthread/port/esc_hw.c
@@ -0,0 +1,220 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "board.h"
+#include "hpm_esc_drv.h"
+#include "hpm_gpio_drv.h"
+#include "esc.h"
+#include "esc_port.h"
+#include <string.h>
+#include <rthw.h>
+#include "hpm_csr_drv.h"
+#include "object_dictionary.h"
+#include "sync_guard.h"
+
+static struct rt_event esc_wakeup;
+static volatile uint32_t sync_sequence, sync_time_us;
+uint32_t hpm_soes_cycle_us;
+
+uint32_t hpm_soes_time_us(void)
+{
+    uint64_t cycles = hpm_csr_get_core_mcycle();
+    return (uint32_t)((cycles / hpm_core_clock) * 1000000ULL +
+                     (cycles % hpm_core_clock) * 1000000ULL / hpm_core_clock);
+}
+
+static void pdi_irq(void)
+{
+    /* Level-triggered PDI stays masked until the owner has serviced the ESC. */
+    intc_m_disable_irq(IRQn_ESC);
+    rt_event_send(&esc_wakeup, 1);
+}
+SDK_DECLARE_EXT_ISR_M(IRQn_ESC, pdi_irq)
+
+static void sync0_irq(void)
+{
+    /* HPM6E requires a dword read at 0x98c to acknowledge SYNC0/1. */
+    (void)*(volatile uint32_t *)(HPM_ESC_BASE + 0x98c);
+    sync_time_us = hpm_soes_time_us();
+    ++sync_sequence;
+    rt_event_send(&esc_wakeup, 1);
+}
+SDK_DECLARE_EXT_ISR_M(IRQn_ESC_SYNC0, sync0_irq)
+
+uint32_t hpm_soes_sync_snapshot(uint32_t *time_us)
+{
+    rt_base_t level = rt_hw_interrupt_disable();
+    uint32_t sequence = sync_sequence;
+    *time_us = sync_time_us;
+    rt_hw_interrupt_enable(level);
+    return sequence;
+}
+
+void hpm_soes_wait(void)
+{
+    intc_m_enable_irq_with_priority(IRQn_ESC, 4);
+    rt_uint32_t received;
+    rt_event_recv(&esc_wakeup, 1, RT_EVENT_FLAG_OR | RT_EVENT_FLAG_CLEAR,
+                  rt_tick_from_millisecond(1), &received);
+}
+
+void hpm_soes_irq_enable(uint32_t mask)
+{
+    if (mask & ESCREG_ALEVENT_DC_SYNC0) {
+        /* In DC mode the thread consumes both PDO directions on SYNC0. */
+        mask &= ~(ESCREG_ALEVENT_DC_SYNC0 | ESCREG_ALEVENT_SM2 | ESCREG_ALEVENT_SM3);
+        ESC_ALeventmaskwrite(ESC_ALeventmaskread() &
+                            ~(ESCREG_ALEVENT_SM2 | ESCREG_ALEVENT_SM3));
+        (void)*(volatile uint32_t *)(HPM_ESC_BASE + 0x98c);
+        esc_enable_irq(HPM_ESC, esc_sync0_irq_mask);
+        intc_m_enable_irq_with_priority(IRQn_ESC_SYNC0, 3);
+    } else if (mask & (ESCREG_ALEVENT_SM2 | ESCREG_ALEVENT_SM3)) {
+        hpm_soes_irq_disable(ESCREG_ALEVENT_DC_SYNC0);
+    }
+    ESC_ALeventmaskwrite(ESC_ALeventmaskread() | mask);
+}
+
+void hpm_soes_irq_disable(uint32_t mask)
+{
+    if (mask & ESCREG_ALEVENT_DC_SYNC0) {
+        intc_m_disable_irq(IRQn_ESC_SYNC0);
+        esc_disable_irq(HPM_ESC, esc_sync0_irq_mask);
+        ESCvar.dcsync = 0;
+        hpm_soes_cycle_us = 0;
+        od_set(0x1c32, 1, 0);
+        od_set(0x1c33, 1, 0);
+        od_set(0x1c32, 2, 0);
+        od_set(0x1c33, 2, 0);
+    }
+    ESC_ALeventmaskwrite(ESC_ALeventmaskread() & ~mask);
+}
+
+uint16_t hpm_soes_check_dc(void)
+{
+    hpm_soes_irq_disable(ESCREG_ALEVENT_DC_SYNC0 | ESCREG_ALEVENT_SM2 | ESCREG_ALEVENT_SM3);
+#ifdef ETHERCANFD_DC_SYNC0
+    uint8_t activation;
+    ESC_read(ESCREG_SYNC_ACT, &activation, sizeof(activation));
+    if (activation != (ESCREG_SYNC_ACT_ACTIVATED | ESCREG_SYNC_SYNC0_EN))
+        return ALERR_DCINVALIDSYNCCFG;
+    uint32_t ns;
+    ESC_read(ESCREG_SYNC0_CYCLE_TIME, &ns, sizeof(ns));
+    ns = etohl(ns);
+    uint32_t cycle_us = sync0_cycle_us(activation, ns);
+    if (!cycle_us)
+        return ALERR_DCSYNC0CYCLETIME;
+    hpm_soes_cycle_us = cycle_us;
+    ESCvar.dcsync = 1;
+    od_set(0x1c32, 1, 2);
+    od_set(0x1c33, 1, 2);
+    od_set(0x1c32, 2, ns);
+    od_set(0x1c33, 2, ns);
+    return 0;
+#else
+    return ALERR_DCINVALIDSYNCCFG;
+#endif
+}
+
+extern const uint8_t ethercanfd_sii[];
+extern const unsigned ethercanfd_sii_size;
+
+/* Device accesses must not be optimized into ordinary RAM memcpy calls. */
+void ESC_read(uint16_t address, void *buf, uint16_t len)
+{
+    uint8_t *dst = buf;
+    /* HPM6E ESC bulk reads require aligned 32-bit bus transactions. */
+    while (len) {
+        unsigned offset = address & 3u;
+        uint32_t word = *(volatile const uint32_t *)(HPM_ESC_BASE + (address & ~3u));
+        unsigned count = 4u - offset;
+        if (count > len) count = len;
+        memcpy(dst, (uint8_t *)&word + offset, count);
+        dst += count;
+        address += count;
+        len -= count;
+    }
+    ESCvar.ALevent = HPM_ESC->AL_EVT_REQ;
+}
+
+void ESC_write(uint16_t address, void *buf, uint16_t len)
+{
+    volatile uint8_t *dst = (volatile uint8_t *)(HPM_ESC_BASE + address);
+    const uint8_t *src = buf;
+    while (len--) *dst++ = *src++;
+    __asm__ volatile("fence iorw, iorw" ::: "memory");
+    ESCvar.ALevent = HPM_ESC->AL_EVT_REQ;
+}
+
+void hpm_soes_eeprom(void)
+{
+    if (!(HPM_ESC->EEPROM_CTRL_STAT & ESC_EEPROM_CTRL_STAT_BUSY_MASK)) return;
+    uint8_t cmd = esc_get_eeprom_cmd(HPM_ESC);
+    uint32_t value = 0;
+    bool error = false;
+    if (cmd == esc_eeprom_reload_cmd) {
+        uint8_t config = ethercanfd_sii[1];
+        value = ethercanfd_sii[8] | ((uint32_t)ethercanfd_sii[9] << 8);
+        value |= ESC_ESC_CFG_ELDAP_GET(config) << 16;
+        value |= ESC_ESC_CFG_ELP0_GET(config) << 17;
+        value |= ESC_ESC_CFG_ELP1_GET(config) << 18;
+        value |= ESC_ESC_CFG_ELP2_GET(config) << 19;
+        value |= ESC_ESC_CFG_ELP3_GET(config) << 20;
+        esc_write_eeprom_data(HPM_ESC, value);
+    } else if (cmd == esc_eeprom_read_cmd) {
+        uint32_t word = esc_get_eeprom_word_address(HPM_ESC);
+        if (word > (ethercanfd_sii_size - 4u) / 2u) error = true;
+        else {
+            memcpy(&value, &ethercanfd_sii[word * 2u], sizeof(value));
+            esc_write_eeprom_data(HPM_ESC, value);
+        }
+    } else if (cmd != esc_eeprom_idle_cmd) {
+        /* The build-generated SII is immutable; never acknowledge lost writes. */
+        error = true;
+    }
+    esc_eeprom_emulation_ack(HPM_ESC, cmd, error, false);
+}
+
+rt_err_t hpm_soes_init(void)
+{
+    intc_m_disable_irq(IRQn_ESC);
+    intc_m_disable_irq(IRQn_ESC_SYNC0);
+    intc_m_disable_irq(IRQn_ESC_SYNC1);
+    if (rt_event_init(&esc_wakeup, "esc", RT_IPC_FLAG_PRIO) != RT_EOK)
+        return -RT_ERROR;
+    board_init_ethercat(HPM_ESC);
+    esc_disable_irq(HPM_ESC, esc_irq_mask_all);
+    esc_eeprom_clock_config_t config = {
+        .core_clock_en = true, .phy_refclk_en = true,
+        .eeprom_emulation = true, .eeprom_size_over_16kbit = false
+    };
+    esc_config_eeprom_and_clock(HPM_ESC, &config);
+    /* PDI registers stall the bus until the ESC core clock is enabled. */
+    HPM_ESC->PDI_AL_EVT_MSK = 0;
+    rt_tick_t start = rt_tick_get();
+    while (!(HPM_ESC->ESC_DL_STAT & 1u)) {
+        hpm_soes_eeprom();
+        if (rt_tick_get() - start >= rt_tick_from_millisecond(1000)) return -RT_ETIMEOUT;
+        rt_thread_mdelay(1);
+    }
+    esc_set_phy_offset(HPM_ESC, BOARD_ECAT_PHY_ADDR_OFFSET);
+    esc_config_ctrl_signal_function(HPM_ESC, BOARD_ECAT_NMII_LINK0_CTRL_INDEX,
+        esc_ctrl_signal_func_alt_nmii_link0, BOARD_ECAT_PORT0_LINK_INVERT);
+    esc_config_ctrl_signal_function(HPM_ESC, BOARD_ECAT_NMII_LINK1_CTRL_INDEX,
+        esc_ctrl_signal_func_alt_nmii_link1, BOARD_ECAT_PORT1_LINK_INVERT);
+    esc_config_nmii_link_source(HPM_ESC, true, true, false);
+    rt_thread_mdelay(10);
+    gpio_write_pin(BOARD_ECAT_PHY0_RESET_GPIO, BOARD_ECAT_PHY0_RESET_GPIO_PORT_INDEX,
+                   BOARD_ECAT_PHY0_RESET_PIN_INDEX, !BOARD_ECAT_PHY_RESET_LEVEL);
+    gpio_write_pin(BOARD_ECAT_PHY1_RESET_GPIO, BOARD_ECAT_PHY1_RESET_GPIO_PORT_INDEX,
+                   BOARD_ECAT_PHY1_RESET_PIN_INDEX, !BOARD_ECAT_PHY_RESET_LEVEL);
+    rt_thread_mdelay(100);
+    return RT_EOK;
+}
+
+void ESC_init(const esc_cfg_t *cfg)
+{
+    (void)cfg; /* Hardware is checked before entering SOES's startup wait. */
+}
+
+void ESC_reset(void)
+{
+    esc_pdi_reset(HPM_ESC);
+}
