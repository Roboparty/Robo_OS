diff --git a/rtthread/applications/sync_guard.h b/rtthread/applications/sync_guard.h
new file mode 100644
index 0000000..25c5cac
--- /dev/null
+++ b/rtthread/applications/sync_guard.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+
+static inline uint32_t sync0_cycle_us(uint8_t activation, uint32_t ns)
+{
+    /* Cyclic unit + SYNC0 only; no SYNC1, auto-activation or sub-us cycles. */
+    if (activation != 3 || ns < 1000000 || ns > 10000000 || ns % 1000)
+        return 0;
+    return ns / 1000;
+}
+
+struct sync_guard {
+    uint32_t sequence;
+    uint32_t last_us;
+    int balance;
+    bool active;
+};
+
+/* Unsigned subtraction tolerates the 32-bit microsecond and sequence wraps. */
+static inline bool sync_guard_update(struct sync_guard *guard, uint32_t now,
+    uint32_t sequence, uint32_t pulse_us, uint32_t cycle_us, bool output, bool op)
+{
+    if (!op) {
+        *guard = (struct sync_guard){sequence, now, 0, false};
+        return true;
+    }
+    if (!guard->active) {
+        guard->active = true;
+        guard->last_us = now;
+    }
+    uint32_t pulses = sequence - guard->sequence;
+    guard->sequence = sequence;
+    if (pulses > 1) return false;
+    if (pulses) {
+        if (now - pulse_us >= cycle_us) return false;
+        guard->last_us = pulse_us;
+        guard->balance += output ? 0 : -1;
+    }
+    return now - guard->last_us < 3 * cycle_us && guard->balance >= -2;
+}
diff --git a/rtthread/check_soes.c b/rtthread/check_soes.c
new file mode 100644
index 0000000..1f1217e
--- /dev/null
+++ b/rtthread/check_soes.c
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "esc.h"
+#include "esc_coe.h"
+#include "object_dictionary.h"
+#include "pdo.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+_ESCvar ESCvar;
+
+int main(void)
+{
+    assert(od_get(0x1018, 1) == 0x11bc);
+    assert(od_get(0x1c12, 1) == 0x1600);
+    assert(od_get(0x1c13, 1) == 0x1a00);
+    for (unsigned index = 0x1c32; index <= 0x1c33; ++index) {
+        assert(od_get(index, 1) == 0);
+        assert(od_get(index, 4) == (EXPECT_DC_SYNC0 ? 5 : 1));
+        assert(od_get(index, 5) == 1000000);
+    }
+    for (unsigned sub = 1; sub <= 4; ++sub) assert(od_get(0x1c00, sub) == sub);
+    for (unsigned ch = 0; ch < 4; ++ch) {
+        assert(od_get(0x8000 + ch * 16, 1) == 0);
+        assert(od_get(0x8000 + ch * 16, 3) == 2000000);
+        assert(od_get(0x8000 + ch * 16, 4) == 8000000);
+    }
+    _SMmap mappings[32];
+    int count;
+    assert(sizeOfPDO(0x1c12, &count, mappings, 32) == 288 && count == 32);
+    for (unsigned i = 0; i < 32; ++i) assert(mappings[i].obj != NULL);
+    assert(sizeOfPDO(0x1c13, &count, mappings, 32) == 288 && count == 32);
+
+    uint8_t output[288] CC_ALIGNED(8), input[288] CC_ALIGNED(8);
+    for (unsigned i = 0; i < sizeof(output); ++i) output[i] = (i * 37 + 11) & 0xff;
+    gateway_pdo_copy(output, 0x7000, true);
+    for (unsigned ch = 0; ch < 4; ++ch) {
+        unsigned idx = 0x7000 + ch * 16;
+        assert(od_get(idx, 1) == (output[ch * 72] | (output[ch * 72 + 1] << 8)));
+        assert(memcmp(od_data(idx, 6, 30), output + ch * 72 + 8, 30) == 0);
+        assert(memcmp(od_data(idx, 7, 30), output + ch * 72 + 38, 30) == 0);
+        assert(memcmp(od_data(idx, 8, 4), output + ch * 72 + 68, 4) == 0);
+    }
+    memset(input, 0, sizeof(input));
+    gateway_pdo_copy(input, 0x7000, false);
+    assert(memcmp(input, output, sizeof(input)) == 0);
+    gateway_pdo_copy(output, 0x6000, true);
+    memset(input, 0, sizeof(input));
+    gateway_pdo_copy(input, 0x6000, false);
+    assert(memcmp(input, output, sizeof(input)) == 0);
+    /* Exercise sparse sub-index lookup with ASan enabled. */
+    assert(od_data(0x1c32, 0xff, 2) == NULL);
+    assert(od_data(0xffff, 0, 1) == NULL);
+    puts("SOES dictionary and four-channel 64-byte PDO payload checks passed");
+    return 0;
+}
diff --git a/rtthread/check_sync.c b/rtthread/check_sync.c
new file mode 100644
index 0000000..1981606
--- /dev/null
+++ b/rtthread/check_sync.c
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "sync_guard.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void)
+{
+    assert(sync0_cycle_us(3, 1000000) == 1000);
+    assert(sync0_cycle_us(3, 10000000) == 10000);
+    assert(sync0_cycle_us(3, 1001000) == 1001);
+    assert(sync0_cycle_us(3, 999999) == 0);
+    assert(sync0_cycle_us(3, 10000001) == 0);
+    assert(sync0_cycle_us(3, 1000001) == 0);
+    assert(sync0_cycle_us(7, 1000000) == 0);
+    assert(sync0_cycle_us(11, 1000000) == 0);
+    assert(sync0_cycle_us(0, 1000000) == 0);
+    struct sync_guard guard = {0};
+    assert(sync_guard_update(&guard, 100, 10, 0, 1000, false, false));
+    assert(sync_guard_update(&guard, 1200, 11, 1100, 1000, true, true));
+    assert(sync_guard_update(&guard, 2200, 12, 2100, 1000, true, true));
+    /* A delayed owner must not replay two queued cycles. */
+    assert(!sync_guard_update(&guard, 4200, 14, 4100, 1000, true, true));
+    assert(sync_guard_update(&guard, 5000, 14, 4100, 1000, false, false));
+    /* A stale first pulse after SAFEOP is rejected too. */
+    assert(!sync_guard_update(&guard, 7200, 15, 6100, 1000, true, true));
+    assert(sync_guard_update(&guard, 10000, 20, 10000, 1000, false, false));
+    assert(sync_guard_update(&guard, 10000, 20, 10000, 1000, false, true));
+    assert(sync_guard_update(&guard, 12999, 20, 10000, 1000, false, true));
+    assert(!sync_guard_update(&guard, 13000, 20, 10000, 1000, false, true));
+    /* Three SYNC0 cycles without a fresh output PDO force a sync error. */
+    assert(sync_guard_update(&guard, 20000, 30, 20000, 1000, false, false));
+    assert(sync_guard_update(&guard, 21000, 31, 21000, 1000, false, true));
+    assert(sync_guard_update(&guard, 22000, 32, 22000, 1000, false, true));
+    assert(!sync_guard_update(&guard, 23000, 33, 23000, 1000, false, true));
+    /* Both counters can wrap while the gateway stays in OP. */
+    assert(sync_guard_update(&guard, UINT32_MAX - 999, UINT32_MAX,
+                             UINT32_MAX - 999, 1000, false, false));
+    assert(sync_guard_update(&guard, 100, 0, 0, 1000, true, true));
+    assert(sync_guard_update(&guard, 1100, 1, 1000, 1000, true, true));
+    puts("SYNC0 backlog, stale pulse, missing PDO, timeout and wrap checks passed");
+    return 0;
+}
