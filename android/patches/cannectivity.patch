+++ b/soc/roboparty/stm32g5x/clock.c
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#define DT_DRV_COMPAT roboparty_stm32g5_rcc
+#include <zephyr/drivers/clock_control.h>
+#include <zephyr/drivers/clock_control/stm32_clock_control.h>
+#include <zephyr/irq.h>
+#include <stm32g5xx_ll_rcc.h>
+#include <stm32g5xx_ll_pwr.h>
+#include <stm32g5xx_ll_bus.h>
+#include <stm32g5xx_ll_crs.h>
+
+static bool clocks_ready;
+
+/* Domain IDs 1/2/3 are FDCAN/USB/TIM2; other IDs are RCC enable-register offsets. */
+static bool gate_valid(const struct stm32_pclken *clock)
+{
+	return clock && (clock->bus == 0x94 || clock->bus == 0x9c ||
+			 clock->bus == 0xa0 || clock->bus == 0xa4);
+}
+
+static int gate(const struct device *dev, clock_control_subsys_t sys, bool on)
+{
+	const struct stm32_pclken *clock = sys;
+	ARG_UNUSED(dev);
+	if (!clocks_ready) {
+		return -EIO;
+	}
+	if (!gate_valid(clock)) {
+		return -EINVAL;
+	}
+	volatile uint32_t *reg = (void *)((uintptr_t)RCC + clock->bus);
+	unsigned int key = irq_lock();
+	if (on) {
+		*reg |= clock->enr;
+	} else {
+		*reg &= ~clock->enr;
+	}
+	(void)*reg;
+	irq_unlock(key);
+	return 0;
+}
+
+static int clock_on(const struct device *dev, clock_control_subsys_t sys)
+{
+	return gate(dev, sys, true);
+}
+
+static int clock_off(const struct device *dev, clock_control_subsys_t sys)
+{
+	return gate(dev, sys, false);
+}
+
+static int clock_rate(const struct device *dev, clock_control_subsys_t sys, uint32_t *rate)
+{
+	const struct stm32_pclken *clock = sys;
+	ARG_UNUSED(dev);
+	if (!clocks_ready) {
+		return -EIO;
+	}
+	if (!clock || !rate) {
+		return -EINVAL;
+	}
+	if (clock->div != 0) {
+		return -ENOTSUP;
+	}
+	if (clock->bus == 1) {
+		*rate = 80000000;
+	} else if (clock->bus == 2) {
+		*rate = 48000000;
+	} else if (clock->bus == 3 || gate_valid(clock)) {
+		*rate = 64000000;
+	} else {
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static int clock_configure(const struct device *dev, clock_control_subsys_t sys, void *data)
+{
+	const struct stm32_pclken *clock = sys;
+	ARG_UNUSED(dev);
+	ARG_UNUSED(data);
+	if (!clocks_ready) {
+		return -EIO;
+	}
+	return clock && clock->bus >= 1 && clock->bus <= 3 && clock->enr == 0 ? 0 : -EINVAL;
+}
+
+static int clock_init(const struct device *dev)
+{
+	ARG_UNUSED(dev);
+	/* Keep the CPU at reset HSI 64 MHz; PLL1 Q feeds only FDCAN at 80 MHz. */
+	if (LL_RCC_GetSysClkSource() != LL_RCC_SYS_CLKSOURCE_STATUS_HSI ||
+	    (RCC->CR & (RCC_CR_HSIDIV | RCC_CR_PLL1ON)) ||
+	    (RCC->CFGR2 & (RCC_CFGR2_HPRE | RCC_CFGR2_PPRE1 | RCC_CFGR2_PPRE2)) ||
+	    (RCC->PLL1CFGR & RCC_PLL1CFGR_PLL1FRACEN)) {
+		return -ENOTSUP;
+	}
+	LL_RCC_PLL1_SetSource(LL_RCC_PLL1SOURCE_HSI);
+	LL_RCC_PLL1_SetM(8);
+	LL_RCC_PLL1_SetN(40);
+	LL_RCC_PLL1_SetQ(4);
+	LL_RCC_PLL1_SetInputRange(LL_RCC_PLLINPUTRANGE_8_16);
+	LL_RCC_PLL1_SetVCORange(LL_RCC_PLLVCORANGE_150_420);
+	LL_RCC_PLL1_EnableOutputQ();
+	LL_RCC_PLL1_Enable();
+	LL_RCC_HSI48_Enable();
+	for (uint32_t timeout = 1000000; timeout; --timeout) {
+		if (LL_RCC_PLL1_IsReady() && LL_RCC_HSI48_IsReady()) {
+			LL_RCC_SetFDCANClockSource(LL_RCC_FDCAN_CLKSOURCE_PLL1Q);
+			LL_RCC_SetUSBClockSource(LL_RCC_USB_CLKSOURCE_HSI48);
+			LL_PWR_EnableUSBSupply();
+			/* Trim the 48 MHz RC oscillator against the host's 1 kHz SOF. */
+			LL_APB1_GRP1_EnableClock(LL_APB1_GRP1_PERIPH_CRS);
+			LL_CRS_SetSyncSignalSource(CRS, LL_CRS_SYNC_SOURCE_USB);
+			LL_CRS_SetSyncDivider(CRS, LL_CRS_SYNC_DIV_1);
+			LL_CRS_SetSyncPolarity(CRS, LL_CRS_SYNC_POLARITY_RISING);
+			LL_CRS_SetReloadCounter(CRS, 47999);
+			LL_CRS_SetFreqErrorLimit(CRS, 34);
+			LL_CRS_EnableAutoTrimming(CRS);
+			LL_CRS_EnableFreqErrorCounter(CRS);
+			clocks_ready = true;
+			return 0;
+		}
+	}
+	return -ETIMEDOUT;
+}
+
+static DEVICE_API(clock_control, clock_api) = {
+	.on = clock_on,
+	.off = clock_off,
+	.get_rate = clock_rate,
+	.configure = clock_configure,
+};
+
+DEVICE_DT_INST_DEFINE(0, clock_init, NULL, NULL, NULL, PRE_KERNEL_1,
+		      CONFIG_CLOCK_CONTROL_INIT_PRIORITY, &clock_api);
diff --git a/soc/roboparty/stm32g5x/soc.c b/soc/roboparty/stm32g5x/soc.c
