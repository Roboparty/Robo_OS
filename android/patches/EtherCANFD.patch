+++ b/rtthread/applications/SConscript
@@ -0,0 +1,30 @@
+# SPDX-License-Identifier: GPL-3.0-only
+import os
+from building import *
+
+cwd = GetCurrentDir()
+soes = os.path.join(os.environ['SOES_ROOT'], 'soes')
+src = Glob('*.c') + Glob('port/*.c') + Glob('generated/*.c')
+src += [os.path.join(soes, name) for name in
+        ('esc.c', 'esc_coe.c', 'ecat_slv.c')]
+usb_paths = []
+# Expose only the endian aliases required by SOES gcc/cc.h. Enabling all
+# Newlib BSD extensions conflicts with RT-Thread's sys/select.h include order.
+defines = ['BYTE_ORDER=_BYTE_ORDER', 'LITTLE_ENDIAN=_LITTLE_ENDIAN',
+           'BIG_ENDIAN=_BIG_ENDIAN']
+if GetDepend('ETHERCANFD_USB'):
+    usb = os.environ['CHERRYUSB_ROOT']
+    defines += ['CONFIG_CHERRYUSB_CUSTOM_IRQ_HANDLER', 'USB_MAX_EP0_SIZE=64']
+    src += Glob('usb/*.c')
+    src += [os.path.join(os.environ['HPM_SDK_ROOT'], 'drivers/src/hpm_ewdg_drv.c')]
+    src += [os.path.join(usb, name) for name in (
+        'core/usbd_core.c', 'port/hpmicro/usb_dc_hpm.c',
+        'port/hpmicro/usb_glue_hpm.c')]
+    usb_paths = [os.path.join(cwd, 'usb')]
+    usb_paths += [os.path.join(usb, name) for name in
+                  ('common', 'core', 'osal', 'port/hpmicro')]
+group = DefineGroup('EtherCANFD', src, depend=[''], CPPPATH=[
+    cwd, os.path.join(cwd, 'port'), os.path.join(cwd, 'generated'),
+    soes, os.path.join(soes, 'include/sys/gcc')] + usb_paths,
+    LOCAL_CPPDEFINES=defines)
+Return('group')
diff --git a/rtthread/applications/gateway.c b/rtthread/applications/gateway.c
new file mode 100644
index 0000000..91de21b
--- /dev/null
+++ b/rtthread/applications/gateway.c
@@ -0,0 +1,209 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include <rtthread.h>
+#include <string.h>
+#include "board.h"
+#include "can_port.h"
+#include "ecat_slv.h"
+#include "esc_coe.h"
+#include "object_dictionary.h"
+#include "gateway.h"
+
+static bool ready[4];
+static bool clocked[4];
+static bool faulted[4];
+static uint16_t trigger[4], sequence[4];
+static uint16_t observed[4];
+static rt_tick_t observed_at[4];
+static rt_tick_t submitted[4];
+static bool output_active;
+
+static void cancel(unsigned ch)
+{
+    MCAN_Type *base = gateway_can_base(ch);
+    if (base && clocked[ch]) base->TXBCR = base->TXBRP;
+}
+
+void gateway_stop(void)
+{
+    output_active = false;
+    for (unsigned ch = 0; ch < 4; ++ch) {
+        cancel(ch);
+        trigger[ch] = od_get(0x7000 + 0x10 * ch, 5);
+        observed[ch] = trigger[ch];
+    }
+}
+
+static bool configure(unsigned ch)
+{
+    MCAN_Type *base = gateway_can_base(ch);
+    uint16_t idx = 0x8000 + ch * 0x10;
+    ready[ch] = false;
+    if (!base) return od_get(idx, 1) == 0;
+    if (!gateway_can_prepare(ch)) return false;
+    board_init_can(base);
+    uint32_t clock = board_init_can_clock(base);
+    if (!clock) return false;
+    clocked[ch] = true;
+    cancel(ch);
+    mcan_deinit(base);
+    if (!od_get(idx, 1)) {
+        faulted[ch] = false;
+        return true;
+    }
+    if (faulted[ch]) return false; /* Explicit disable required after bus-off. */
+    mcan_config_t cfg;
+    mcan_get_default_config(base, &cfg);
+    cfg.baudrate = od_get(idx, 3);
+    cfg.baudrate_fd = od_get(idx, 4);
+    cfg.enable_canfd = od_get(idx, 2) != 0;
+    cfg.use_lowlevel_timing_setting = false;
+    cfg.enable_tdc = cfg.enable_canfd && cfg.baudrate_fd > 1000000;
+    uint32_t offset = (uint64_t)clock * 3 / ((uint64_t)cfg.baudrate_fd * 4);
+    if (cfg.enable_tdc && offset > 127) return false;
+    cfg.tdc_config.ssp_offset = offset;
+    cfg.tdc_config.filter_window_length = 0;
+    cfg.mode = mcan_mode_normal;
+    cfg.interrupt_mask = 0;
+    cfg.disable_auto_retransmission = true;
+    mcan_get_default_ram_config(base, &cfg.ram_config, cfg.enable_canfd);
+    ready[ch] = mcan_init(base, &cfg, clock) == status_success;
+    if (!ready[ch]) mcan_deinit(base);
+    trigger[ch] = od_get(0x7000 + ch * 0x10, 5);
+    return ready[ch];
+}
+
+void gateway_init(void)
+{
+    for (unsigned ch = 0; ch < 4; ++ch) configure(ch);
+    gateway_stop();
+}
+
+void cb_set_outputs(void)
+{
+    bool active = (ESCvar.ALstatus & 0x1f) == ESCop && !od_get(0xa000, 1);
+    if (!active || !output_active) {
+        gateway_stop();
+        output_active = active;
+        return;
+    }
+    for (unsigned ch = 0; ch < 4; ++ch) {
+        uint16_t idx = 0x7000 + ch * 0x10;
+        uint16_t next = od_get(idx, 5);
+        MCAN_Type *base = gateway_can_base(ch);
+        if (!ready[ch] || !next || next == trigger[ch]) continue;
+        if (next != observed[ch]) {
+            observed[ch] = next;
+            observed_at[ch] = rt_tick_get();
+        }
+        if (rt_tick_get() - observed_at[ch] >= rt_tick_from_millisecond(20)) {
+            trigger[ch] = next;
+            continue;
+        }
+        /* Reject a new request while the previous one is still pending. */
+        if (base->TXBRP) continue;
+        mcan_tx_frame_t frame = {0};
+        unsigned dlc = od_get(idx, 3), flags = od_get(idx, 4);
+        uint32_t lo = od_get(idx, 1), hi = od_get(idx, 2);
+        trigger[ch] = next;
+        if (dlc > 15 || (flags & ~3u) || (hi & 0xc000u) ||
+            (!(flags & 1) && (dlc > 8 || (flags & 2))) ||
+            ((flags & 1) && !od_get(0x8000 + ch * 0x10, 2)) ||
+            (!(hi & 0x2000) && (hi || lo > 0x7ff))) continue;
+        frame.use_ext_id = !!(hi & 0x2000);
+        if (frame.use_ext_id) frame.ext_id = ((hi & 0x1fff) << 16) | lo;
+        else frame.std_id = lo;
+        frame.dlc = dlc;
+        frame.canfd_frame = flags & 1;
+        frame.bitrate_switch = !!(flags & 2);
+        memcpy(frame.data_8, od_data(idx, 6, 30), 30);
+        memcpy(frame.data_8 + 30, od_data(idx, 7, 30), 30);
+        memcpy(frame.data_8 + 60, od_data(idx, 8, 4), 4);
+        uint32_t slot;
+        if (mcan_transmit_via_txfifo_nonblocking(base, &frame, &slot) == status_success)
+            submitted[ch] = rt_tick_get();
+    }
+}
+
+void cb_get_inputs(void)
+{
+    for (unsigned ch = 0; ch < 4; ++ch) {
+        if (!ready[ch]) continue;
+        uint16_t idx = 0x6000 + ch * 0x10;
+        mcan_rx_message_t frame;
+        if (mcan_read_rxfifo(gateway_can_base(ch), 0, &frame) != status_success) continue;
+        if (od_get(0xa000, 2) || frame.rtr) continue;
+        uint32_t id = frame.use_ext_id ? frame.ext_id : frame.std_id;
+        od_set(idx, 1, id & 0xffff);
+        od_set(idx, 2, (id >> 16) | (frame.use_ext_id ? 0x2000 : 0));
+        od_set(idx, 3, frame.dlc);
+        od_set(idx, 4, frame.canfd_frame | (frame.bitrate_switch << 1));
+        if (++sequence[ch] == 0) ++sequence[ch];
+        od_set(idx, 5, sequence[ch]);
+        uint8_t payload[64] = {0};
+        memcpy(payload, frame.data_8, mcan_get_message_size_from_dlc(frame.dlc));
+        memcpy(od_data(idx, 6, 30), payload, 30);
+        memcpy(od_data(idx, 7, 30), payload + 30, 30);
+        memcpy(od_data(idx, 8, 4), payload + 60, 4);
+    }
+}
+
+void gateway_poll(void)
+{
+    if ((ESCvar.ALstatus & 0x1f) != ESCop || od_get(0xa000, 1)) gateway_stop();
+    for (unsigned ch = 0; ch < 4; ++ch) {
+        MCAN_Type *base = gateway_can_base(ch);
+        if (!base || !ready[ch]) continue;
+        mcan_error_count_t errors;
+        mcan_get_error_counter(base, &errors);
+        bool busoff = mcan_is_in_busoff_state(base);
+        mcan_protocol_status_t status;
+        mcan_get_protocol_status(base, &status);
+        od_set(0x9000 + ch * 0x10, 1, busoff ? 3 : status.in_error_passive_state ? 2 : status.in_warning_state ? 1 : 0);
+        od_set(0x9000 + ch * 0x10, 2, mcan_get_last_error_code(base));
+        od_set(0x9000 + ch * 0x10, 3, errors.transmit_error_count);
+        od_set(0x9000 + ch * 0x10, 4, errors.receive_error_count);
+        if (base->TXBRP && rt_tick_get() - submitted[ch] >= rt_tick_from_millisecond(20)) cancel(ch);
+        if (busoff) {
+            cancel(ch);
+            mcan_deinit(base);
+            ready[ch] = false;
+            faulted[ch] = true;
+        }
+    }
+}
+
+uint32_t gateway_validate_sdo(uint16_t index, uint8_t subindex, void *data, size_t size, uint16_t flags)
+{
+    if (index >= 0x8000 && index <= 0x8030 && !(index & 0xf)) {
+        if ((flags & COMPLETE_ACCESS_FLAG) || subindex == 0 || subindex > 5) return ABORT_UNSUPPORTED;
+        if ((ESCvar.ALstatus & 0x0f) != ESCpreop) return ABORT_NOTINTHISSTATE;
+        uint32_t value = 0;
+        if (size != ((subindex == 3 || subindex == 4) ? 4u : 1u)) return ABORT_TYPEMISMATCH;
+        memcpy(&value, data, size);
+        if ((subindex <= 2 || subindex == 5) && value > 1) return ABORT_VALUE_EXCEEDED;
+        if (subindex == 5 && value) return ABORT_UNSUPPORTED;
+        if (subindex == 1 && value && !gateway_can_base((index - 0x8000) / 16)) return ABORT_VALUE_EXCEEDED;
+        if (subindex == 3 && (value < 10000 || value > 2000000)) return ABORT_VALUE_EXCEEDED;
+        if (subindex == 4 && (value < 10000 || value > 8000000)) return ABORT_VALUE_EXCEEDED;
+    }
+    /* Sync mode follows ESC registers; writable timing/log controls are unsupported. */
+    if (index == 0x1c32 || index == 0x1c33 || index == 0xa010) return ABORT_UNSUPPORTED;
+    if (index == 0xa000) {
+        if ((flags & COMPLETE_ACCESS_FLAG) || size != 1 || subindex < 1 || subindex > 2)
+            return ABORT_UNSUPPORTED;
+        if (*(uint8_t *)data > 1) return ABORT_VALUE_EXCEEDED;
+    }
+    return 0;
+}
+
+uint32_t gateway_apply_sdo(uint16_t index, uint8_t subindex, uint16_t flags)
+{
+    (void)subindex;
+    (void)flags;
+    if (index >= 0x8000 && index <= 0x8030 && !(index & 0xf)) {
+        if (configure((index - 0x8000) / 16)) return 0;
+        od_set(index, 1, 0);
+        return ABORT_GENERALERROR;
+    }
+    return 0;
+}
