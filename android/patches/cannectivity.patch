diff --git a/tests/scripts/test_stm32_fs_matrix.py b/tests/scripts/test_stm32_fs_matrix.py
new file mode 100644
index 0000000..05ecf59
--- /dev/null
+++ b/tests/scripts/test_stm32_fs_matrix.py
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Offline regression tests for STM32 package/pin validation."""
+
+import importlib.util
+import json
+from pathlib import Path
+from types import SimpleNamespace as Node
+import unittest
+
+
+spec = importlib.util.spec_from_file_location(
+    "matrix", Path(__file__).resolve().parents[2] / "scripts/stm32-fs-matrix.py"
+)
+matrix = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(matrix)
+
+
+def pin(port, line, mode):
+    return ((ord(port) - ord("A")) << 9) | (line << 5) | mode
+
+
+class PinValidationTests(unittest.TestCase):
+    def setUp(self):
+        assignments = {
+            "fdcan1": [("FDCAN1_RX", "A", 6, 9), ("FDCAN1_TX", "A", 7, 9)],
+            "fdcan2": [("FDCAN2_RX", "A", 4, 13), ("FDCAN2_TX", "A", 5, 13)],
+            "fdcan3": [("FDCAN3_RX", "A", 8, 6), ("FDCAN3_TX", "B", 7, 8)],
+            "zephyr_udc0": [("USB_DM", "A", 11, 16), ("USB_DP", "A", 12, 16)],
+        }
+        self.package = {"die_pads": {}, "signals": []}
+        self.edt = Node(label2node={})
+        for label, entries in assignments.items():
+            groups = []
+            for signal, port, line, mode in entries:
+                pad = f"P{port}{line}"
+                self.package["die_pads"][pad] = {}
+                self.package["signals"].append({
+                    "name": signal, "die_pad": pad,
+                    "function": {"type": "additional"} if mode == 16 else
+                                {"type": "alternate", "id": f"AF{mode}"},
+                })
+                groups.append(Node(props={"pinmux": Node(val=pin(port, line, mode))}, children={}))
+            self.edt.label2node[label] = Node(props={"pinctrl-0": Node(val=groups)})
+        self.descriptor = Node(read_text=lambda: json.dumps(self.package))
+
+    def check(self):
+        return matrix.check_g5_pins(self.edt, self.descriptor)
+
+    def group(self, label, index=0):
+        return self.edt.label2node[label].props["pinctrl-0"].val[index]
+
+    def test_valid_package_and_grouped_pins(self):
+        group = self.group("fdcan1")
+        group.props["pinmux"].val = [group.props["pinmux"].val]
+        self.assertEqual(len(self.check()), 8)
+        self.assertEqual(self.check()["USB_DM"], {"pin": "PA11", "mode": "analog"})
+
+    def test_wrong_alternate_function(self):
+        self.group("fdcan1").props["pinmux"].val = pin("A", 6, 8)
+        with self.assertRaisesRegex(ValueError, "invalid or duplicate signal"):
+            self.check()
+
+    def test_absent_package_pad(self):
+        del self.package["die_pads"]["PA6"]
+        with self.assertRaisesRegex(ValueError, "absent"):
+            self.check()
+
+    def test_shared_usb_can_pad(self):
+        self.group("fdcan1").props["pinmux"].val = pin("A", 11, 9)
+        self.package["signals"][0]["die_pad"] = "PA11"
+        with self.assertRaisesRegex(ValueError, "already used"):
+            self.check()
+
+    def test_missing_tx(self):
+        self.edt.label2node["fdcan2"].props["pinctrl-0"].val.pop()
+        with self.assertRaisesRegex(ValueError, "missing pins"):
+            self.check()
+
+    def test_duplicate_signal_on_different_pad(self):
+        self.package["signals"][1]["name"] = "FDCAN1_RX"
+        with self.assertRaisesRegex(ValueError, "invalid or duplicate signal"):
+            self.check()
+
+
+if __name__ == "__main__":
+    unittest.main()
